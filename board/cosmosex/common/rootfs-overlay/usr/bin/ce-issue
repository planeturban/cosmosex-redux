#!/bin/sh
# Generate the HDMI login banner (/run/issue, shown by getty on tty1).
#
#   ce-issue           write the banner
#   ce-issue refresh   write it and, if it changed, restart the getty waiting
#                      at the login prompt so the screen shows the new text
#
# Called at boot and then every minute (S99ceissue), and by the dhcpcd hook
# when addresses change.
# Shown by ce-console-login, which getty runs on tty1.

ISSUE=/run/issue
NEW=/run/issue.new.$$     # per run: boot script and dhcpcd hook can overlap

# Atari Fuji logo, one rainbow colour per row (the Linux console has 16
# colours; 33 = dark yellow, which shows as orange), with the title beside it.
logo() {
	e=$(printf '\033')
	b=$(printf '\033[1m')      # bold/bright
	r=$(printf '\033[0m')
	echo
	echo "  ${e}[31m    ██ ██ ██     ${r}"
	echo "  ${e}[33m    ██ ██ ██     ${r}"
	echo "  ${e}[1;33m    ██ ██ ██     ${r}   ${b}C O S M O S E X${r}"
	echo "  ${e}[32m   ██  ██  ██    ${r}"
	echo "  ${e}[36m  ███  ██  ███   ${r}   Atari ST ACSI / SCSI / floppy emulator"
	echo "  ${e}[34m ███   ██   ███  ${r}"
	echo "  ${e}[35m███    ██    ███ ${r}"
	echo
}

ip4() {
	ip -4 addr show dev "$1" 2>/dev/null | awk '$1 == "inet" { sub("/.*", "", $2); print $2; exit }'
}

{
	printf '\033[H\033[2J'      # clear the screen
	logo
	echo "  $(cat /etc/cosmosex-release 2>/dev/null || echo 'Buildroot image')"
	echo "  ------------------------------------------------------------------"
	echo "  Hostname   $(hostname)"

	ips=""
	for ifc in $(ls /sys/class/net); do
		[ "$ifc" = lo ] && continue
		addr=$(ip4 "$ifc")
		if [ -n "$addr" ]; then
			echo "  $(printf '%-10s' "$ifc") $addr"
			ips="$ips $addr"
		elif [ "$(cat "/sys/class/net/$ifc/carrier" 2>/dev/null)" = 1 ]; then
			echo "  $(printf '%-10s' "$ifc") link up, waiting for DHCP"
		else
			echo "  $(printf '%-10s' "$ifc") no link"
		fi
	done
	for addr in $ips; do
		echo "  Web UI     http://$addr/      SSH  ce@$addr"
		break
	done
	# the web interface's login (the app: webauth.cpp; settings in /ce/settings)
	if [ -e /boot/insecure.txt ]; then
		echo "  Web login  OFF: insecure.txt is on the SD card (remove it to use the login)"
	elif [ "$(cat /ce/settings/WEBUI_LOGIN 2>/dev/null || echo 1)" = 0 ]; then
		echo "  Web login  OFF (switched off in Config > Web login)"
	elif [ -s /ce/settings/WEBUI_PWHASH ]; then
		echo "  Web login  on (your password)"
	else
		echo "  Web login  password: thisisnotsecure (the default: change it in Config > Web login)"
	fi
	echo

	pid=$(pidof cosmosex)
	if [ -n "$pid" ]; then
		echo "  App        running (pid $pid)"
	else
		echo "  App        NOT running"
	fi
	fw=""
	for chip in hans franz xilinx; do
		fw="$fw $chip $(cat /ce/update/$chip.current 2>/dev/null || echo '?')"
	done
	echo "  Chip FW   $fw"

	mounts=$(awk '$2 ~ "^/mnt/" { print $2 }' /proc/mounts | tr '\n' ' ')
	echo "  Drives     ${mounts:-none mounted}"
	# Events from this boot's storage setup (ce-preinit): /storage created,
	# factory reset, problems
	if [ -s /data/boot-notice ]; then
		while IFS= read -r line; do echo "  ! $line"; done < /data/boot-notice
	fi
	if mountpoint -q /data; then
		echo "  Settings   $(df -h /data | awk 'NR == 2 { print $4 " free of " $2 }') (data partition)"
	else
		echo "  Settings   NOT SAVED: no data partition (see /boot/ce-recovery.txt)"
	fi
	if mountpoint -q /storage; then
		echo "  Storage    $(df -h /storage | awk 'NR == 2 { print $4 " free of " $2 }')"
	else
		echo "  Storage    unavailable (see /var/log/preinit.log)"
	fi
	keys=$(grep -c . /home/ce/.ssh/authorized_keys 2>/dev/null)
	if [ "${keys:-0}" -gt 0 ]; then
		echo "  SSH keys   $keys installed for user ce"
	else
		echo "  SSH keys   none - copy your *.pub file to the SD card's CosmosEx volume"
	fi
	echo

	temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
	[ -n "$temp" ] && temp="$((temp / 1000)) C" || temp="?"
	power="OK"
	for h in /sys/class/hwmon/hwmon*; do
		if [ "$(cat "$h/name" 2>/dev/null)" = rpi_volt ] && [ "$(cat "$h/in0_lcrit_alarm" 2>/dev/null)" = 1 ]; then
			power="UNDER-VOLTAGE detected - check the power supply"
		fi
	done
	echo "  CPU temp   $temp      Power  $power"
	up=$(awk '{ s = int($1); printf "%dd %dh %dm", s / 86400, s % 86400 / 3600, s % 3600 / 60 }' /proc/uptime)
	# local time: the clock runs in UTC. A time zone chosen in the web interface
	# (its rule, a POSIX TZ string) or else the app's "UTC offset" setting
	# (hours); the Atari's clock gets the same.
	rule=$(head -n 1 /ce/settings/TIME_ZONE_RULE 2>/dev/null)
	case "$rule" in *[!A-Za-z0-9\<\>+:,./-]*|"") rule= ;; esac
	if [ -n "$rule" ]; then
		now=$(TZ="$rule" date '+%Y-%m-%d %H:%M %Z')
	else
		zone=$(awk '{ o = $1 + 0; s = int(o * 3600 + (o < 0 ? -0.5 : 0.5)); a = s < 0 ? -s : s; m = int(a % 3600 / 60)
			printf "%d UTC%s", s, s ? sprintf("%s%d%s", s < 0 ? "-" : "+", int(a / 3600), m ? sprintf(":%02d", m) : "") : ""; exit }' /ce/settings/TIME_UTC_OFFSET 2>/dev/null)
		[ -n "$zone" ] || zone="0 UTC"
		now="$(date -u -d "@$(($(date +%s) + ${zone%% *}))" '+%Y-%m-%d %H:%M') ${zone#* }"
	fi
	echo "  Time       $now      Up  $up"
	echo "  Boot       $(/usr/bin/ce-boottime --short 2>/dev/null)"
	echo
	# The app takes the USB keyboard for the Atari (as on the stock image,
	# whose motd said so); this combination toggles it (Ikbd::handleHotkeys)
	echo "  Keyboard   a USB keyboard types on the Atari. For this console press"
	echo "             Left Ctrl + Left Alt + Right Ctrl + Right Alt together"
	echo "             (the same again gives it back to the Atari)"
	echo
	echo "  Diagnostics: run ce-report (also saved to the SD card's boot partition)"
	echo
} > "$NEW"

if cmp -s "$NEW" "$ISSUE"; then
	rm -f "$NEW"
	exit 0
fi
chmod 644 "$NEW"            # readable by the console login (also when run with sudo's umask)
mv "$NEW" "$ISSUE"

# Restart tty1 only while nobody is logged in there: getty, the "Press Enter"
# wait (ce-console-login) or a login prompt. A logged-in shell isn't matched.
if [ "$1" = refresh ]; then
	pkill -t tty1 -x getty 2>/dev/null
	pkill -t tty1 -f ce-console-login 2>/dev/null
	pkill -t tty1 -x login 2>/dev/null
fi
exit 0
