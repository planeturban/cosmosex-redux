#!/bin/sh
#
# Start/stop dhcpcd
#
# CosmosEx: Buildroot's script, plus -b: fork to the background at once
# instead of waiting for a lease, so the rest of the boot (SSH, HDMI banner,
# console) doesn't wait for DHCP. The banner updates itself when an address
# arrives (dhcpcd hook).
#

DAEMON=/sbin/dhcpcd
CONFIG=/etc/dhcpcd.conf
PIDFILE=/var/run/dhcpcd/pid

[ -f $CONFIG ] || exit 0

case "$1" in
  start)
	echo "Starting dhcpcd..."
	start-stop-daemon -S -x "$DAEMON" -p "$PIDFILE" -- -b -f "$CONFIG"
	;;
  stop)
	echo "Stopping dhcpcd..."
	start-stop-daemon -K -x "$DAEMON" -p "$PIDFILE" -o
	;;
  reload|force-reload)
	echo "Reloading dhcpcd configuration..."
	"$DAEMON" -s reload
	;;
  restart)
	"$0" stop
	sleep 1 # Prevent race condition: ensure dhcpcd stops before start.
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart|reload|force-reload}"
	exit 1
esac
