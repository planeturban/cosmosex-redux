<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- The CosmosEx web interface, announced on the network (Bonjour) -->
<service-group>
  <name replace-wildcards="yes">CosmosEx %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
  </service>
</service-group>
