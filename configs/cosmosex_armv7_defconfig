# Target: Raspberry Pi 2, 3 and 3 B+, 32-bit ARMv7 (main deliverable; the
# Pi 1 gets cosmosex_armv6, and cosmosex_arm64 is the optional 64-bit build)
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y

# Internal toolchain (Bootlin's prebuilt ones only run on x86-64 hosts)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# toolchain headers pinned to Buildroot 2026.02.3's Pi kernel (6.12.61): a
# kernel update doesn't rebuild the toolchain
BR2_KERNEL_HEADERS_CUSTOM_TARBALL=y
BR2_KERNEL_HEADERS_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# System
BR2_TARGET_GENERIC_HOSTNAME="cosmosex"
BR2_TARGET_GENERIC_ISSUE="CosmosEx (Buildroot)"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /usr/libexec/ce-console-login"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/common/users.table"
# the root filesystem stays read-only
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/common/post-image.sh"

# Kernel: same Raspberry Pi kernel (6.12.61) as Buildroot's raspberrypi3_64_defconfig
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# Raspberry Pi kernel, rpi-6.12.y at 6.12.116 (2026-11-15)
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,ab4372076bb840600e522ae776887ae2bc488fa6)/linux-ab4372076bb840600e522ae776887ae2bc488fa6.tar.gz"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/armv7/linux.defconfig"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/common/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Pi 2 (v1.1: BCM2836; v1.2: BCM2837), Pi 3, Pi 3 B+; the firmware picks one.
# bcm2709-rpi-2-b is also the one QEMU uses (-M raspi2b).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2709-rpi-2-b broadcom/bcm2710-rpi-2-b broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware and boot files
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI_CD=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/armv7/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_COSMOSEX_PATH)/board/cosmosex/common/cmdline.txt"

# Packages
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_COSMOSEX=y
BR2_PACKAGE_CE_WEBUI=y
BR2_PACKAGE_CE_SCREENSAVER=y
BR2_PACKAGE_CE_TRYBOOT=y
BR2_PACKAGE_CE_FILES=y
BR2_PACKAGE_CE_GEMDOSFS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_LIBCURL_CURL=y
# nginx in front of the app's web server (board/.../etc/nginx/nginx.conf):
# the proxy and gzip modules only
BR2_PACKAGE_NGINX=y
BR2_PACKAGE_NGINX_HTTP=y
BR2_PACKAGE_NGINX_HTTP_GZIP_MODULE=y
BR2_PACKAGE_NGINX_HTTP_PROXY_MODULE=y
# BR2_PACKAGE_NGINX_HTTP_CHARSET_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_SSI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_USERID_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_ACCESS_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_AUTH_BASIC_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_AUTOINDEX_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_GEO_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_MAP_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_SPLIT_CLIENTS_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_REFERER_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_REWRITE_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_FASTCGI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UWSGI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_SCGI_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_MEMCACHED_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_LIMIT_CONN_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_LIMIT_REQ_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_EMPTY_GIF_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_BROWSER_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UPSTREAM_IP_HASH_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UPSTREAM_LEAST_CONN_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UPSTREAM_KEEPALIVE_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UPSTREAM_RANDOM_MODULE is not set
# BR2_PACKAGE_NGINX_HTTP_UPSTREAM_ZONE_MODULE is not set
BR2_PACKAGE_CIVETWEB=y
BR2_PACKAGE_CIVETWEB_LIB=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_SUDO=y
# Shared drive: autofs mounts it on access (ce-shared-mount, ce-atari patch 0007)
BR2_PACKAGE_AUTOFS=y
BR2_PACKAGE_NFS_UTILS=y
BR2_PACKAGE_CIFS_UTILS=y
# util-linux mount: runs mount.nfs/mount.cifs helpers (BusyBox's doesn't)
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
# ce-preinit (sfdisk, partx, blkid, e2fsck, mkfs.ext4)
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_XZ=y

# Images
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
# <hostname>.local (mDNS) and the services it announces
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# BR2_PACKAGE_AVAHI_AUTOIPD is not set
# media streaming (the app runs /usr/local/bin/ffmpeg ... -f au -c pcm_s8 -):
# audio only, the formats people play, nothing else
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_ENCODERS="pcm_s8"
BR2_PACKAGE_FFMPEG_DECODERS="mp3 mp3float mp2 aac flac vorbis opus alac wavpack pcm_s16le pcm_s16be pcm_s24le pcm_u8 pcm_f32le"
BR2_PACKAGE_FFMPEG_MUXERS="au"
BR2_PACKAGE_FFMPEG_DEMUXERS="mp3 aac flac ogg wav aiff au mov matroska"
BR2_PACKAGE_FFMPEG_PARSERS="mpegaudio aac flac vorbis opus"
BR2_PACKAGE_FFMPEG_BSFS=""
BR2_PACKAGE_FFMPEG_PROTOCOLS="file pipe http tcp"
BR2_PACKAGE_FFMPEG_FILTERS="aresample aformat anull abuffer abuffersink"
# BR2_PACKAGE_FFMPEG_INDEVS is not set
# BR2_PACKAGE_FFMPEG_OUTDEVS is not set
# /storage over SMB: userspace for the kernel SMB server (ksmbd)
BR2_PACKAGE_KSMBD_TOOLS=y
# firewall rules for the /storage SMB share (ce-storageshare)
BR2_PACKAGE_NFTABLES=y
