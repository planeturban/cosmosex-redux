{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosmosex.example/schemas/imagelist-1.schema.json",
  "title": "CosmosEx floppy image list, format_version 1",
  "description": "Extended image list (see docs/imagelist-format.md). Unknown fields are allowed and ignored.",
  "type": "object",
  "required": ["format", "format_version", "entries"],
  "properties": {
    "format": { "const": "cosmosex-imagelist" },
    "format_version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "list_version": { "$ref": "#/$defs/shortText" },
    "name": { "$ref": "#/$defs/shortText" },
    "description": { "type": "string", "maxLength": 4096 },
    "base_url": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://", "maxLength": 2048 },
    "generated": { "type": "string", "maxLength": 64 },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "shortText": { "type": "string", "maxLength": 256 },

    "reference": {
      "description": "file / src: a path relative to the list location, or an http(s) URL (web lists only). No '..' components, no absolute paths, no other schemes (file:, data:, javascript:, ...).",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "allOf": [
        { "not": { "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)" } },
        { "not": { "pattern": "^[/\\\\]" } },
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "anyOf": [
          { "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://[^/]" },
          { "not": { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:" } }
        ] }
      ]
    },

    "media": {
      "type": "object",
      "properties": {
        "role": { "enum": ["thumbnail", "title", "screenshot", "box", "other"] },
        "data": {
          "description": "Base64 (standard alphabet) of a PNG, JPEG, WebP or GIF picture, at most 256 KB decoded. A data:<mime>;base64, prefix is accepted.",
          "type": "string",
          "pattern": "^(data:[^,]*;base64,)?[A-Za-z0-9+/]*={0,2}$"
        },
        "src": {
          "allOf": [
            { "$ref": "#/$defs/reference" },
            { "not": { "pattern": "\\.[Ss][Vv][Gg]([?#].*)?$" } }
          ]
        },
        "mime": { "type": "string", "maxLength": 64 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "caption": { "$ref": "#/$defs/shortText" }
      },
      "oneOf": [
        { "required": ["data"], "not": { "required": ["src"] } },
        { "required": ["src"], "not": { "required": ["data"] } }
      ]
    },

    "mediaList": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/media" } },

    "game": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 256 },
        {
          "type": "object",
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 256 },
            "media": { "$ref": "#/$defs/mediaList" }
          }
        }
      ]
    },

    "disk": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "$ref": "#/$defs/reference" },
        "label": { "$ref": "#/$defs/shortText" },
        "size": { "type": "integer", "minimum": 0 },
        "md5": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "inner_md5": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
        "checksum": { "type": "string", "maxLength": 64 },
        "container": { "type": "string", "maxLength": 64 },
        "format": { "type": "string", "maxLength": 64 }
      }
    },

    "entry": {
      "type": "object",
      "required": ["id", "title", "disks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "type": { "$ref": "#/$defs/shortText" },
        "group": { "$ref": "#/$defs/shortText" },
        "year": { "type": "integer" },
        "tags": { "type": "array", "items": { "$ref": "#/$defs/shortText" } },
        "games": { "type": "array", "items": { "$ref": "#/$defs/game" } },
        "disks": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/disk" } },
        "media": { "$ref": "#/$defs/mediaList" },
        "compat": {
          "type": "object",
          "properties": {
            "machines": { "type": "array", "items": { "type": "string" } },
            "ram_kb_min": { "type": "integer", "minimum": 0 },
            "tos": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "string" }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "$ref": "#/$defs/shortText" },
              "url": { "type": "string", "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://" }
            }
          }
        }
      }
    }
  }
}
