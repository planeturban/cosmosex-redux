+// "path" or "path RO" -> path, read-only
+static std::string splitImageSetting(std::string img, bool *readOnly)
+{
+    while(!img.empty() && (img[img.length() - 1] == '\n' || img[img.length() - 1] == ' ')) img.erase(img.length() - 1);
+    bool ro = false;
+    size_t sp = img.find_last_of(' ');
+    if(sp != std::string::npos) {
+        std::string end = img.substr(sp + 1);
+        if(end == "RO" || end == "READONLY" || end == "READ_ONLY") { ro = true; img.erase(sp); }
+    }
+    if(readOnly) *readOnly = ro;
+    return img;
+}
+
+// the image set for an ACSI ID (HDDIMAGE_<id>, Scsi::loadSettings)
+static std::string idImage(Settings &s, int id, bool *readOnly)
+{
+    char key[32];
+    snprintf(key, sizeof(key), "HDDIMAGE_%d", id);
+    return splitImageSetting(s.getString(key, ""), readOnly);
+}
+
+static void setIdImage(Settings &s, int id, const std::string &path, bool readOnly)
+{
+    char key[32];
+    snprintf(key, sizeof(key), "HDDIMAGE_%d", id);
+    std::string v = path;
+    if(!v.empty() && readOnly) v += " RO";
+    s.setString(key, v.c_str());
+}
+
+// the ID an image is set for (also the old single HDDIMAGE: 8), -1: none
+static int imageId(Settings &s, const std::string &path)
+{
+    for(int id = 0; id < 8; id++) if(!path.empty() && idImage(s, id, NULL) == path) return id;
+    if(!path.empty() && splitImageSetting(s.getString("HDDIMAGE", ""), NULL) == path) return 8;
+    return -1;
+}
+
 // the attached image's path (HDDIMAGE without " RO")
