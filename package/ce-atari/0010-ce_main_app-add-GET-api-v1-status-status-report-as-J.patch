+#ifndef STATUSRESOURCE_H
+#define	STATUSRESOURCE_H
+
+#include <string>
+
+#include "../../CivetServer.h"
+
+#include "iapiresource.h"
+
+// GET /api/v1/status: the device status report (as /app/status/) as JSON,
+// for the web UI's Overview page.
+class StatusResource : public IApiResource {
+public:
+    StatusResource();
+    virtual ~StatusResource();
+    bool dispatch(mg_connection *conn, mg_request_info *req_info, std::string sResourceInfo="" );
+};
+
+#endif
