+    return true;
+}
+
+// Adds an image unless one with the same name (case-insensitive, without
+// .zip / .st / .msa) came from a source with higher priority
+bool ImageList::addItem(ImageListItem &li, std::map<std::string, bool> &seen)
+{
+    std::string key = li.imageName;
+    std::transform(key.begin(), key.end(), key.begin(), ::tolower);
+    size_t dot = key.rfind('.');
+    if(dot != std::string::npos) {
+        std::string ext = key.substr(dot);
+        if(ext == ".zip" || ext == ".st" || ext == ".msa") key.erase(dot);
+    }
+    if(seen.count(key)) {
+        return false;
+    }
+    seen[key] = true;
+
+    vectorOfImages.push_back(li);
+    if(!li.localPath.empty()) {
+        localImages[li.imageName] = li.localPath;
+    }
+    if(li.sourceIndex >= 0 && li.sourceIndex < (int) sources.size()) {
+        sources[li.sourceIndex].entries++;
+    }
+    return true;
+}
+
+static bool isImageFile(const std::string &name)
+{
+    size_t dot = name.rfind('.');
+    if(dot == std::string::npos) return false;
+    std::string ext = name.substr(dot);
+    std::transform(ext.begin(), ext.end(), ext.begin(), ::tolower);
+    return ext == ".st" || ext == ".msa" || ext == ".zip";
+}
+
+// relative paths of the images below root/rel, dot-folders skipped
+void ImageList::scanFolder(const std::string &root, const std::string &rel, int depth, std::vector<std::string> &found)
+{
+    if(depth > IMAGELIST_SCAN_MAX_DEPTH || (int) found.size() >= IMAGELIST_SCAN_MAX_IMAGES) {
+        return;
+    }
+
+    std::string dirPath = rel.empty() ? root : root + "/" + rel;
+    DIR *dir = opendir(dirPath.c_str());
+    if(!dir) {
+        return;
+    }
+
+    struct dirent *de;
+    while((de = readdir(dir)) != NULL && (int) found.size() < IMAGELIST_SCAN_MAX_IMAGES) {
+        std::string name = de->d_name;
+        if(name.empty() || name[0] == '.') {            // ., .., hidden folders (.cache, saves)
             continue;
         }
-        seen[li.imageName] = true;
+        std::string relPath = rel.empty() ? name : rel + "/" + name;
 
-        vectorOfImages.push_back(li);                   // store it in vector
-        ls.entries++;
+        struct stat st;
+        if(stat((root + "/" + relPath).c_str(), &st) != 0) {
+            continue;
+        }
+        if(S_ISDIR(st.st_mode)) {
+            scanFolder(root, relPath, depth + 1, found);
+        } else if(S_ISREG(st.st_mode) && isImageFile(name)) {
+            found.push_back(relPath);
+        }
     }
+    closedir(dir);
+}
 
-    fclose(f);
+bool ImageList::loadLocalSource(int sourceIndex, std::map<std::string, bool> &seen)
+{
+    ImageListSource &ls = sources[sourceIndex];
+    ls.resolvedPath.clear();
 
-    Debug::out(LOG_DEBUG, "ImageList: %s: %d images (list version %s)", ls.src.id.c_str(), ls.entries, ls.version.c_str());
+    std::string root;
+    if(!ImageStorage::resolveLocation(ls.src.spec, root)) {
+        Debug::out(LOG_DEBUG, "ImageList: %s: drive not attached, skipped", ls.src.id.c_str());
+        return false;
+    }
+    ls.resolvedPath = root;
+    ls.updated      = time(NULL);
+
+    // a list in the folder: titles and games from it, files relative to it
+    std::string csv = root + "/imagelist.csv";
+    if(Utils::fileExists(csv)) {
+        bool ok = loadOneList(sourceIndex, seen, csv.c_str(), root);
+        Debug::out(LOG_DEBUG, "ImageList: %s: %d images from %s", ls.src.id.c_str(), ls.entries, csv.c_str());
+        return ok;
+    }
+
+    // no list: every image in the folder, the file name as its title
+    std::vector<std::string> found;
+    scanFolder(root, "", 0, found);
+    std::sort(found.begin(), found.end());
+
+    for(size_t i=0; i<found.size(); i++) {
+        ImageListItem li;
+        std::string path, file;
+        Utils::splitFilenameFromPath(found[i], path, file);
+        li.imageName    = file;
+        li.localPath    = root + "/" + found[i];
+        li.checksum     = 0;
+        li.sourceIndex  = sourceIndex;
+        li.marked       = false;
+
+        std::string title = file;
+        size_t dot = title.rfind('.');
+        if(dot != std::string::npos) title.erase(dot);
+        std::replace(title.begin(), title.end(), ',', ' ');     // games are comma-separated
+        std::replace(title.begin(), title.end(), '"', '\'');
+        li.gamesDisplay = title;
+        li.games        = title;
+        std::transform(li.games.begin(), li.games.end(), li.games.begin(), ::tolower);
+
+        addItem(li, seen);
+    }
+
+    char ver[32];
+    snprintf(ver, sizeof(ver), "local-%d", ls.entries);
+    ls.version = ver;
+    Debug::out(LOG_DEBUG, "ImageList: %s: %d images found in %s", ls.src.id.c_str(), ls.entries, root.c_str());
+    return true;
+}
+
+bool ImageList::getLocalImagePath(const std::string &imageName, std::string &path)
+{
+    std::map<std::string, std::string>::iterator it = localImages.find(imageName);
+    if(it == localImages.end()) {
+        return false;
+    }
+    path = it->second;
     return true;
 }
 
