+// Hard disk images the web interface lists, downloads, renames and deletes:
+// the files in HDD_IMAGES_DIR (not the notes), and image files in the top
+// folder of a USB drive (/mnt/<drive>/, not the shared drive: a network
+// folder isn't safe for an image the ST writes to).
+static bool hasImageExt(const std::string &name)
+{
+    static const char *ext[] = { ".img", ".hd", ".hdd", ".ima", ".raw", NULL };
+    for(int i=0; ext[i]; i++) {
+        size_t n = strlen(ext[i]);
+        if(name.length() > n && strcasecmp(name.c_str() + name.length() - n, ext[i]) == 0) return true;
+    }
+    return false;
+}
+
+// the USB drives' mount points: /mnt/<x> that are mount points
+static std::vector<std::string> usbMounts(void)
+{
+    std::vector<std::string> out;
+    struct stat mnt;
+    if(stat("/mnt", &mnt) != 0) return out;
+    DIR *d = opendir("/mnt");
+    if(!d) return out;
+    struct dirent *de;
+    while((de = readdir(d)) != NULL) {
+        std::string n = de->d_name;
+        if(n[0] == '.' || n == "shared") continue;
+        std::string p = "/mnt/" + n;
+        struct stat st;
+        if(stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode) && st.st_dev != mnt.st_dev) out.push_back(p);
+    }
+    closedir(d);
+    std::sort(out.begin(), out.end());
+    return out;
+}
+
+// where: "storage" (HDD_IMAGES_DIR) or "usb"; false: not an image we handle
+static bool listedImage(const std::string &path, std::string &real, std::string &where)
+{
+    char r[PATH_MAX];
+    if(path.empty() || path[0] != '/' || !realpath(path.c_str(), r)) return false;
+    real = r;
+    struct stat st;
+    if(stat(r, &st) != 0 || !S_ISREG(st.st_mode)) return false;
+    size_t slash = real.find_last_of('/');
+    std::string dir = real.substr(0, slash), name = real.substr(slash + 1);
+    if(name.empty() || name[0] == '.') return false;
+    if(dir == HDD_IMAGES_DIR) {
+        if(name.length() > 5 && strcasecmp(name.c_str() + name.length() - 5, ".json") == 0) return false;
+        where = "storage";
+        return true;
+    }
+    std::vector<std::string> m = usbMounts();
+    if(hasImageExt(name) && std::find(m.begin(), m.end(), dir) != m.end()) { where = "usb"; return true; }
+    return false;
+}
+
+// the attached image's path (HDDIMAGE without " RO")
+static std::string attachedImage(Settings &s, bool *readOnly)
+{
+    std::string img = s.getString("HDDIMAGE", "");
+    while(!img.empty() && (img[img.length() - 1] == '\n' || img[img.length() - 1] == ' ')) img.erase(img.length() - 1);
+    bool ro = false;
+    size_t sp = img.find_last_of(' ');
+    if(sp != std::string::npos) {
+        std::string end = img.substr(sp + 1);
+        if(end == "RO" || end == "READONLY" || end == "READ_ONLY") { ro = true; img.erase(sp); }
+    }
+    if(readOnly) *readOnly = ro;
+    return img;
+}
+
 /* -------------------------------------------------------------- sections */
 
 // Notes about a hard disk image in HDD_IMAGES_DIR: <image>.json next to it,
@@ -399,9 +470,41 @@ bool SettingsResource::buildSection(const std::string &name, cJSON *out)
             cJSON_AddStringToObject(o, "path", full.c_str());
             cJSON_AddNumberToObject(o, "sizeMB", (double) (st.st_size / (1024 * 1024)));
             cJSON_AddStringToObject(o, "notes", imageNotes(names[i]).c_str());
+            cJSON_AddStringToObject(o, "where", "storage");
+            cJSON_AddBoolToObject(o, "attached", full == img);
             cJSON_AddItemToArray(imgs, o);
         }
         cJSON_AddItemToObject(out, "images", imgs);
+
+        // image files in the top folder of each USB drive (no notes: the
+        // drive may be read-only or move to another computer)
+        cJSON *usb = cJSON_CreateArray();
+        std::vector<std::string> mounts = usbMounts();
+        for(size_t m=0; m<mounts.size(); m++) {
+            DIR *ud = opendir(mounts[m].c_str());
+            if(!ud) continue;
+            std::vector<std::string> un;
+            struct dirent *ue;
+            while((ue = readdir(ud)) != NULL && un.size() < 100) {
+                if(ue->d_name[0] != '.' && hasImageExt(ue->d_name)) un.push_back(ue->d_name);
+            }
+            closedir(ud);
+            std::sort(un.begin(), un.end());
+            for(size_t i=0; i<un.size(); i++) {
+                std::string full = mounts[m] + "/" + un[i];
+                struct stat st;
+                if(stat(full.c_str(), &st) != 0 || !S_ISREG(st.st_mode)) continue;
+                cJSON *o = cJSON_CreateObject();
+                cJSON_AddStringToObject(o, "name", un[i].c_str());
+                cJSON_AddStringToObject(o, "path", full.c_str());
+                cJSON_AddNumberToObject(o, "sizeMB", (double) (st.st_size / (1024 * 1024)));
+                cJSON_AddStringToObject(o, "where", "usb");
+                cJSON_AddStringToObject(o, "drive", mounts[m].c_str());
+                cJSON_AddBoolToObject(o, "attached", full == img);
+                cJSON_AddItemToArray(usb, o);
+            }
+        }
+        cJSON_AddItemToObject(out, "usbImages", usb);
         return true;
     }
 
