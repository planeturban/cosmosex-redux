+            std::string name = real.substr(real.find_last_of('/') + 1);
+            if(unlink(real.c_str()) != 0) { msg = "Couldn't delete " + name + ": " + strerror(errno) + "."; return false; }
+            unlink((real + ".json").c_str());
+            Debug::out(LOG_INFO, "SettingsResource: deleted HDD image %s", real.c_str());
+            Utils::forceSync();
+            return true;
+        }
+
+        // {"rename": {"path": "<path>", "name": "new name"}}: an image in HDD_IMAGES_DIR, with its notes
+        cJSON *ren = cJSON_GetObjectItem(in, "rename");
+        if(ren) {
+            cJSON *jp = cJSON_GetObjectItem(ren, "path"), *jn = cJSON_GetObjectItem(ren, "name");
+            std::string real, where;
+            if(ren->type != cJSON_Object || !jp || jp->type != cJSON_String || !listedImage(jp->valuestring, real, where) || where != "storage") {
+                msg = "Only images in " HDD_IMAGES_DIR " can be renamed here.";
+                return false;
+            }
+            std::string name = (jn && jn->type == cJSON_String && jn->valuestring) ? jn->valuestring : "";
+            while(!name.empty() && name[name.length() - 1] == ' ') name.erase(name.length() - 1);
+            while(!name.empty() && name[0] == ' ') name.erase(0, 1);
+            bool okName = !name.empty() && name.length() <= 64 && name[0] != '.' && !isNotesFile(name);
+            for(size_t i=0; okName && i<name.length(); i++) {
+                char c = name[i];
+                if(!isalnum((unsigned char) c) && c != '.' && c != '_' && c != '-' && c != ' ') okName = false;
+            }
+            if(!okName) { msg = "The name may have letters, digits, spaces and . _ - (at most 64, not starting with a dot, not .json)."; return false; }
+            std::string to = std::string(HDD_IMAGES_DIR "/") + name;
+            if(to == real) return true;
+            struct stat st;
+            if(lstat(to.c_str(), &st) == 0) { msg = "There's already a file called " + name + "."; return false; }
+            if(rename(real.c_str(), to.c_str()) != 0) { msg = std::string("Couldn't rename: ") + strerror(errno) + "."; return false; }
+            rename((real + ".json").c_str(), (to + ".json").c_str());       // the notes, if any
+            bool ro = false;
+            if(attachedImage(s, &ro) == real) {                             // attached: follow it
+                std::string v = to + (ro ? " RO" : "");
+                s.setString("HDDIMAGE", v.c_str());
+                reload(SETTINGSUSER_ACSI);
+            }
+            Debug::out(LOG_INFO, "SettingsResource: renamed HDD image %s to %s", real.c_str(), to.c_str());
+            Utils::forceSync();
+            return true;
+        }
+
         // {"create": {"name": "games", "sizeMB": 1024}}: only make a new blank image
         cJSON *create = cJSON_GetObjectItem(in, "create");
         if(create) {
@@ -864,6 +1019,37 @@ void SettingsResource::sendError(mg_connection *conn, int code, const char *mess
     sendJson(conn, root, code);
 }
 
+// GET /api/v1/settings/hddimage/download?path=<image>: the file itself
+void SettingsResource::downloadImage(mg_connection *conn, mg_request_info *req_info)
+{
+    char path[PATH_MAX];
+    const char *qs = req_info->query_string ? req_info->query_string : "";
+    std::string real, where;
+    if(mg_get_var(qs, strlen(qs), "path", path, sizeof(path)) <= 0 || !listedImage(path, real, where)) {
+        sendError(conn, 404, "no such image");
+        return;
+    }
+    int fd = open(real.c_str(), O_RDONLY);
+    struct stat st;
+    if(fd < 0 || fstat(fd, &st) != 0) {
+        if(fd >= 0) close(fd);
+        sendError(conn, 500, "can't read the image");
+        return;
+    }
+    std::string name = real.substr(real.find_last_of('/') + 1);
+    for(size_t i=0; i<name.length(); i++) if(name[i] == '"' || name[i] == '\\' || (unsigned char) name[i] < 32) name[i] = '_';
+    mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nCache-Control: no-cache\r\n"
+                    "Content-Disposition: attachment; filename=\"%s\"\r\nContent-Length: %lld\r\n\r\n",
+              name.c_str(), (long long) st.st_size);
+    Debug::out(LOG_INFO, "SettingsResource: sending HDD image %s (%lld bytes)", real.c_str(), (long long) st.st_size);
+    static __thread char buf[65536];
+    ssize_t n;
+    while((n = read(fd, buf, sizeof(buf))) > 0) {
+        if(mg_write(conn, buf, n) != n) break;          // the browser went away
+    }
+    close(fd);
+}
+
