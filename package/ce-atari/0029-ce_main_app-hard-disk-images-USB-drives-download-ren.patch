     }
 
     if(name == "hddimage") {                                // onHddImageSave(), without the usb/shared shortcuts
+        // {"delete": "<path>"}: an image in HDD_IMAGES_DIR (and its notes); not the attached one
+        cJSON *del = cJSON_GetObjectItem(in, "delete");
