+
+/* ------------------------------------------------- encrypted backups */
+
+// A backup with passwords and keys is encrypted with a password the user
+// chooses: AES-256-GCM (wrong password or damaged file: the tag doesn't
+// match, nothing is restored), the key from the password with
+// PBKDF2-HMAC-SHA256. File: header (40 bytes, also authenticated) |
+// encrypted .tar.gz | tag (16 bytes).
+//   header: "CEBK" | version 1 | 0 0 0 | rounds (u32, big-endian) | salt (16) | IV (12)
+#define CEBK_HEADER     40
+#define CEBK_TAG        16
+#define CEBK_ROUNDS     200000
+
+static bool cebkKey(const std::string &password, const unsigned char *salt, unsigned rounds, unsigned char *key)
+{
+    return PKCS5_PBKDF2_HMAC(password.c_str(), password.length(), salt, 16, rounds, EVP_sha256(), 32, key) == 1;
+}
+
+// is this file an encrypted backup?
+static bool isEncryptedBackup(const std::string &path)
+{
+    FILE *f = fopen(path.c_str(), "rb");
+    if(!f) return false;
+    char m[4];
+    bool yes = fread(m, 1, 4, f) == 4 && memcmp(m, "CEBK", 4) == 0;
+    fclose(f);
+    return yes;
+}
+
+// decrypt src to dst; false and dst removed if the password is wrong or the file damaged
+static bool decryptBackup(const std::string &src, const std::string &dst, const std::string &password, std::string &err)
+{
+    FILE *in = fopen(src.c_str(), "rb");
+    if(!in) { err = "Can't read the upload."; return false; }
+    struct stat st;
+    fstat(fileno(in), &st);
+    unsigned char hdr[CEBK_HEADER], tag[CEBK_TAG];
+    if(st.st_size < CEBK_HEADER + CEBK_TAG || fread(hdr, 1, CEBK_HEADER, in) != CEBK_HEADER || memcmp(hdr, "CEBK", 4) != 0 || hdr[4] != 1) {
+        fclose(in); err = "That isn't an encrypted CosmosEx backup (or a newer kind)."; return false;
+    }
+    unsigned rounds = ((unsigned) hdr[8] << 24) | ((unsigned) hdr[9] << 16) | ((unsigned) hdr[10] << 8) | hdr[11];
+    if(rounds < 10000 || rounds > 10000000) { fclose(in); err = "That backup's header is damaged."; return false; }
+    long long dataLen = (long long) st.st_size - CEBK_HEADER - CEBK_TAG;
+    fseek(in, st.st_size - CEBK_TAG, SEEK_SET);
+    if(fread(tag, 1, CEBK_TAG, in) != CEBK_TAG) { fclose(in); err = "That backup is cut short."; return false; }
+    fseek(in, CEBK_HEADER, SEEK_SET);
+
+    unsigned char key[32];
+    if(!cebkKey(password, hdr + 12, rounds, key)) { fclose(in); err = "Decryption failed."; return false; }
+    EVP_CIPHER_CTX *ctx = EVP_CIPHER_CTX_new();
+    FILE *out = fopen(dst.c_str(), "wb");
+    bool ok = ctx && out &&
+              EVP_DecryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) == 1 &&
+              EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, 12, NULL) == 1 &&
+              EVP_DecryptInit_ex(ctx, NULL, NULL, key, hdr + 28) == 1;
+    int outl = 0;
+    if(ok) ok = EVP_DecryptUpdate(ctx, NULL, &outl, hdr, CEBK_HEADER) == 1;      // the header: authenticated
+    std::vector<unsigned char> ib(65536), ob(65536 + 32);
+    long long left = dataLen;
+    while(ok && left > 0) {
+        size_t want = left < (long long) ib.size() ? (size_t) left : ib.size();
+        size_t n = fread(&ib[0], 1, want, in);
+        if(n == 0) { ok = false; break; }
+        ok = EVP_DecryptUpdate(ctx, &ob[0], &outl, &ib[0], n) == 1 && fwrite(&ob[0], 1, outl, out) == (size_t) outl;
+        left -= n;
+    }
+    if(ok) ok = EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_TAG, CEBK_TAG, tag) == 1;
+    bool tagOk = ok && EVP_DecryptFinal_ex(ctx, &ob[0], &outl) == 1;
+    if(ctx) EVP_CIPHER_CTX_free(ctx);
+    OPENSSL_cleanse(key, sizeof(key));
+    fclose(in);
+    if(out && fclose(out) != 0) tagOk = false;
+    if(!tagOk) {
+        unlink(dst.c_str());
+        err = "Wrong backup password, or the file is damaged. Nothing was changed.";
+        return false;
+    }
+    return true;
+}
+
 /* ---------------------------------------------------------------- backup */
 
