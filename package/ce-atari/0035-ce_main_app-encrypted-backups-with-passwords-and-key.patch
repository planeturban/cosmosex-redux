 // made while it's sent (chunked: the size isn't known before)
+// GET ?translated=1&downloads=1: without passwords and keys, not encrypted.
+// POST {"translated", "downloads", "secrets", "password"} (JSON): with
+// "password" the file is encrypted; "secrets" (passwords and keys) needs one.
 void SystemResource::backupDownload(mg_connection *conn, mg_request_info *req_info)
 {
-    const char *qs = req_info->query_string ? req_info->query_string : "";
-    char v[8];
-    std::string args = "create";
-    if(mg_get_var(qs, strlen(qs), "translated", v, sizeof(v)) > 0 && v[0] == '1') args += " --translated";
-    if(mg_get_var(qs, strlen(qs), "downloads", v, sizeof(v)) > 0 && v[0] == '1') args += " --downloads";
+    std::string args = "create", password;
+    bool translated = false, downloads = false, secrets = false;
+    if(strcmp(req_info->request_method, "POST") == 0) {
+        const char *ctype = mg_get_header(conn, "Content-Type");
+        if(!ctype || strncasecmp(ctype, "application/json", 16) != 0) { sendError(conn, 415, "Content-Type must be application/json"); return; }
+        std::string body;
+        char rb[1024];
+        int n;
+        while((n = mg_read(conn, rb, sizeof(rb))) > 0 && body.length() < 8192) body.append(rb, n);
+        cJSON *in = cJSON_Parse(body.c_str());
+        if(!in || in->type != cJSON_Object) { if(in) cJSON_Delete(in); sendError(conn, 400, "invalid JSON"); return; }
+        cJSON *j;
+        translated = (j = cJSON_GetObjectItem(in, "translated")) && j->type == cJSON_True;
+        downloads  = (j = cJSON_GetObjectItem(in, "downloads"))  && j->type == cJSON_True;
+        secrets    = (j = cJSON_GetObjectItem(in, "secrets"))    && j->type == cJSON_True;
+        if((j = cJSON_GetObjectItem(in, "password")) && j->type == cJSON_String && j->valuestring) password = j->valuestring;
+        cJSON_Delete(in);
+        if(!password.empty() && (password.length() < 8 || password.length() > 128)) { sendError(conn, 400, "The backup password: 8 to 128 characters."); return; }
+        if(secrets && password.empty()) { sendError(conn, 400, "A backup with passwords and keys needs a backup password (it's encrypted)."); return; }
+    } else {
+        const char *qs = req_info->query_string ? req_info->query_string : "";
+        char v[8];
+        translated = mg_get_var(qs, strlen(qs), "translated", v, sizeof(v)) > 0 && v[0] == '1';
+        downloads  = mg_get_var(qs, strlen(qs), "downloads", v, sizeof(v)) > 0 && v[0] == '1';
+    }
+    if(translated) args += " --translated";
+    if(downloads)  args += " --downloads";
+    if(secrets)    args += " --secrets";
+    bool encrypt = !password.empty();
 
     std::string host;
     char hn[64];
@@ -340,27 +450,71 @@ void SystemResource::backupDownload(mg_connection *conn, mg_request_info *req_in
     struct tm tmv;
     localtime_r(&now, &tmv);
     char name[128];
-    snprintf(name, sizeof(name), "cosmosex-backup-%s-%04d%02d%02d-%02d%02d.tar.gz", host.empty() ? "cosmosex" : host.c_str(),
-             tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday, tmv.tm_hour, tmv.tm_min);
+    snprintf(name, sizeof(name), "cosmosex-backup-%s-%04d%02d%02d-%02d%02d.tar.gz%s", host.empty() ? "cosmosex" : host.c_str(),
+             tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday, tmv.tm_hour, tmv.tm_min, encrypt ? ".enc" : "");
+
+    // encryption: key from the password, header first
+    unsigned char hdr[CEBK_HEADER], key[32];
+    EVP_CIPHER_CTX *ctx = NULL;
+    if(encrypt) {
+        memset(hdr, 0, sizeof(hdr));
+        memcpy(hdr, "CEBK", 4);
+        hdr[4] = 1;
+        hdr[8] = (CEBK_ROUNDS >> 24) & 255; hdr[9] = (CEBK_ROUNDS >> 16) & 255; hdr[10] = (CEBK_ROUNDS >> 8) & 255; hdr[11] = CEBK_ROUNDS & 255;
+        int outl = 0;
+        ctx = EVP_CIPHER_CTX_new();
+        if(RAND_bytes(hdr + 12, 16 + 12) != 1 || !cebkKey(password, hdr + 12, CEBK_ROUNDS, key) || !ctx ||
+           EVP_EncryptInit_ex(ctx, EVP_aes_256_gcm(), NULL, NULL, NULL) != 1 ||
+           EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_SET_IVLEN, 12, NULL) != 1 ||
+           EVP_EncryptInit_ex(ctx, NULL, NULL, key, hdr + 28) != 1 ||
+           EVP_EncryptUpdate(ctx, NULL, &outl, hdr, CEBK_HEADER) != 1) {
+            if(ctx) EVP_CIPHER_CTX_free(ctx);
+            OPENSSL_cleanse(key, sizeof(key));
+            sendError(conn, 500, "Couldn't set up the encryption.");
+            return;
+        }
+        OPENSSL_cleanse(key, sizeof(key));
+    }
 
     std::string cmd = std::string(BACKUP_TOOL " ") + args + " 2>/dev/null";
     FILE *p = popen(cmd.c_str(), "r");
     if(!p) { sendError(conn, 500, "Couldn't make the backup."); return; }
-    mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: application/gzip\r\nCache-Control: no-cache\r\n"
-                    "Content-Disposition: attachment; filename=\"%s\"\r\nTransfer-Encoding: chunked\r\n\r\n", name);
+    mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nCache-Control: no-cache\r\n"
+                    "Content-Disposition: attachment; filename=\"%s\"\r\nTransfer-Encoding: chunked\r\n\r\n",
+              encrypt ? "application/octet-stream" : "application/gzip", name);
     std::vector<char> bufv(65536);     // on the heap: per-thread (TLS) buffers made every thread need more stack than civetweb gives its workers
+    std::vector<unsigned char> encv(65536 + 32);
     char *buf = &bufv[0];
     size_t n;
     long long total = 0;
     bool ok = true;
-    while((n = fread(buf, 1, bufv.size(), p)) > 0) {
-        char head[16];
-        int hl = snprintf(head, sizeof(head), "%lx\r\n", (unsigned long) n);
-        if(mg_write(conn, head, hl) != hl || mg_write(conn, buf, n) != (int) n || mg_write(conn, "\r\n", 2) != 2) { ok = false; break; }
+    // one chunk of the chunked response
+    #define SEND_CHUNK(ptr, len) do { char head[16]; int hl = snprintf(head, sizeof(head), "%lx\r\n", (unsigned long) (len)); \
+        if(mg_write(conn, head, hl) != hl || mg_write(conn, (ptr), (len)) != (int) (len) || mg_write(conn, "\r\n", 2) != 2) ok = false; } while(0)
+    if(encrypt) SEND_CHUNK(hdr, CEBK_HEADER);
+    while(ok && (n = fread(buf, 1, bufv.size(), p)) > 0) {
+        if(encrypt) {
+            int outl = 0;
+            if(EVP_EncryptUpdate(ctx, &encv[0], &outl, (unsigned char *) buf, n) != 1) { ok = false; break; }
+            if(outl > 0) SEND_CHUNK(&encv[0], outl);
+        } else {
+            SEND_CHUNK(buf, n);
+        }
         total += n;
     }
     if(!ok) while(fread(buf, 1, bufv.size(), p) > 0) { }     // let the tool finish
     pclose(p);
+    if(ok && encrypt) {
+        int outl = 0;
+        unsigned char tag[CEBK_TAG];
+        if(EVP_EncryptFinal_ex(ctx, &encv[0], &outl) != 1 || EVP_CIPHER_CTX_ctrl(ctx, EVP_CTRL_GCM_GET_TAG, CEBK_TAG, tag) != 1) ok = false;
+        else {
+            if(outl > 0) SEND_CHUNK(&encv[0], outl);
+            SEND_CHUNK(tag, CEBK_TAG);
+        }
+    }
+    #undef SEND_CHUNK
+    if(ctx) EVP_CIPHER_CTX_free(ctx);
     if(ok) mg_write(conn, "0\r\n\r\n", 5);
     Debug::out(LOG_INFO, "SystemResource: backup %s sent (%lld bytes%s)", name, total, ok ? "" : ", cut short");
 }
@@ -415,6 +569,22 @@ void SystemResource::backupRestore(mg_connection *conn)
     if(pthread_mutex_trylock(&uploadMutex) != 0) { sendError(conn, 409, "Another upload is running."); return; }
     std::string path;
     if(!receiveFile(conn, BACKUP_TOOL, BACKUP_MAX_MB, "restore.tar.gz", path)) { pthread_mutex_unlock(&uploadMutex); return; }
+    if(isEncryptedBackup(path)) {                       // encrypted: the password comes in X-Backup-Password
+        const char *pw = mg_get_header(conn, "X-Backup-Password");
+        if(!pw || !pw[0]) {
+            unlink(path.c_str()); pthread_mutex_unlock(&uploadMutex);
+            sendError(conn, 400, "This backup is encrypted: enter its backup password.");
+            return;
+        }
+        char pwd[512];                                  // URL-encoded by the page (headers are ASCII)
+        if(mg_url_decode(pw, (int) strlen(pw), pwd, sizeof(pwd), 0) < 0) pwd[0] = 0;
+        std::string err, plain = path + ".plain";
+        bool dec = decryptBackup(path, plain, pwd, err);
+        OPENSSL_cleanse(pwd, sizeof(pwd));
+        unlink(path.c_str());
+        if(!dec) { pthread_mutex_unlock(&uploadMutex); sendError(conn, 400, err); return; }
+        if(rename(plain.c_str(), path.c_str()) != 0) { unlink(plain.c_str()); pthread_mutex_unlock(&uploadMutex); sendError(conn, 500, "Couldn't keep the decrypted backup."); return; }
+    }
     bool started = startToolAt(BACKUP_TOOL, "restore '" + path + "' delete");
     pthread_mutex_unlock(&uploadMutex);
     if(!started) { unlink(path.c_str()); sendError(conn, 500, "Couldn't start the restore."); return; }
