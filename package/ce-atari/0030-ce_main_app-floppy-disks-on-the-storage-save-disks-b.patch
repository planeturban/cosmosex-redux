+std::string UnpackCache::cacheDir(void)
+{
+    struct stat st;
+    if(stat(FLOPPY_STORAGE_READY, &st) == 0) {             // the storage is mounted
+        mkdir(FLOPPY_DISKS_DIR, 0775);
+        if(isDir(FLOPPY_DISKS_DIR)) return FLOPPY_DISKS_DIR;
+    }
+    return UNPACK_RAM_DIR;
+}
+
+void UnpackCache::noteSaved(const std::string &imagePath)
+{
+    std::string disks = FLOPPY_DISKS_DIR "/";
+    if(imagePath.compare(0, disks.length(), disks) == 0) {      // an unpacked zip: a save disk now
+        size_t slash = imagePath.find('/', disks.length());
+        if(slash == std::string::npos) return;
+        std::string marker = imagePath.substr(0, slash) + "/" UNPACK_WRITTEN_MARKER;
+        struct stat st;
+        if(stat(marker.c_str(), &st) == 0) return;
+        FILE *f = fopen(marker.c_str(), "w");
+        if(f) { fclose(f); ownTree(marker); Debug::out(LOG_INFO, "UnpackCache: %s has saves now: kept", imagePath.c_str()); }
+        return;
+    }
+
+    // an image file elsewhere on the storage, saved in place: list it once
+    if(imagePath.compare(0, strlen(FLOPPY_STORAGE_ROOT), FLOPPY_STORAGE_ROOT) != 0) return;
+    struct stat st;
+    if(stat(FLOPPY_STORAGE_READY, &st) != 0) return;
+    FILE *f = fopen(FLOPPY_WRITTEN_LIST, "r");
+    if(f) {
+        char line[PATH_MAX + 2];
+        while(fgets(line, sizeof(line), f)) {
+            line[strcspn(line, "\r\n")] = 0;
+            if(imagePath == line) { fclose(f); return; }
+        }
+        fclose(f);
+    }
+    mkdir(FLOPPY_DISKS_DIR, 0775);
+    f = fopen(FLOPPY_WRITTEN_LIST, "a");
+    if(f) { fprintf(f, "%s\n", imagePath.c_str()); fclose(f); }
+}
