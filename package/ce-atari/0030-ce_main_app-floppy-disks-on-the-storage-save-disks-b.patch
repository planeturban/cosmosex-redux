+// a disk folder on the storage belongs to user pi like the rest of it
+// (shared over SMB/NFS as pi), group-writable; unzip keeps the zip's modes
+static void ownTree(const std::string &path)
+{
+    struct stat st;
+    if(lstat(path.c_str(), &st) != 0 || S_ISLNK(st.st_mode)) return;
+    if(lchown(path.c_str(), 1000, 1000) != 0) { /* not fatal */ }
+    if(S_ISDIR(st.st_mode)) {
+        chmod(path.c_str(), 02775);
+        DIR *d = opendir(path.c_str());
+        if(!d) return;
+        struct dirent *de;
+        while((de = readdir(d)) != NULL) {
+            if(strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+            ownTree(path + "/" + de->d_name);
+        }
+        closedir(d);
+    } else if(S_ISREG(st.st_mode)) {
+        chmod(path.c_str(), 0664);
+    }
+}
