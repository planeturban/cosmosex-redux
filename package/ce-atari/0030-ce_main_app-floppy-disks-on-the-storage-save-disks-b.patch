+/* ---------------------------------------------------------------- backup */
+
+void SystemResource::backupInfo(mg_connection *conn)
+{
+    std::string out;
+    runToolAt(BACKUP_TOOL, "info", out);
+    cJSON *root = cJSON_CreateObject();
+    cJSON *restore = NULL;
+    size_t pos = 0;
+    while(pos < out.length()) {
+        size_t end = out.find('\n', pos);
+        if(end == std::string::npos) end = out.length();
+        std::string line = out.substr(pos, end - pos);
+        pos = end + 1;
+        size_t eq = line.find('=');
+        if(eq == std::string::npos || eq == 0) continue;
+        std::string k = line.substr(0, eq), v = line.substr(eq + 1);
+        cJSON *obj = root;
+        if(k.compare(0, 8, "restore_") == 0) {
+            if(!restore) { restore = cJSON_CreateObject(); cJSON_AddItemToObject(root, "restore", restore); }
+            obj = restore;
+            k.erase(0, 8);
+        }
+        bool number = k.length() > 2 && (k.compare(k.length() - 2, 2, "KB") == 0 || k.compare(k.length() - 2, 2, "MB") == 0);
+        if(number || k == "saveDisks" || k == "sshKeys" || k == "hddImages") cJSON_AddNumberToObject(obj, k.c_str(), atof(v.c_str()));
+        else if(v == "yes" || v == "no") cJSON_AddBoolToObject(obj, k.c_str(), v == "yes");
+        else cJSON_AddStringToObject(obj, k.c_str(), v.c_str());
+    }
+    sendJson(conn, root);
+}
+
+// made while it's sent (chunked: the size isn't known before)
+void SystemResource::backupDownload(mg_connection *conn, mg_request_info *req_info)
+{
+    const char *qs = req_info->query_string ? req_info->query_string : "";
+    char v[8];
+    std::string args = "create";
+    if(mg_get_var(qs, strlen(qs), "translated", v, sizeof(v)) > 0 && v[0] == '1') args += " --translated";
+    if(mg_get_var(qs, strlen(qs), "downloads", v, sizeof(v)) > 0 && v[0] == '1') args += " --downloads";
+
+    std::string host;
+    char hn[64];
+    if(gethostname(hn, sizeof(hn)) == 0) { hn[sizeof(hn) - 1] = 0; host = hn; }
+    for(size_t i=0; i<host.length(); i++) if(!isalnum((unsigned char) host[i]) && host[i] != '-') host[i] = '_';
+    time_t now = time(NULL);
+    struct tm tmv;
+    localtime_r(&now, &tmv);
+    char name[128];
+    snprintf(name, sizeof(name), "cosmosex-backup-%s-%04d%02d%02d-%02d%02d.tar.gz", host.empty() ? "cosmosex" : host.c_str(),
+             tmv.tm_year + 1900, tmv.tm_mon + 1, tmv.tm_mday, tmv.tm_hour, tmv.tm_min);
+
+    std::string cmd = std::string(BACKUP_TOOL " ") + args + " 2>/dev/null";
+    FILE *p = popen(cmd.c_str(), "r");
+    if(!p) { sendError(conn, 500, "Couldn't make the backup."); return; }
+    mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: application/gzip\r\nCache-Control: no-cache\r\n"
+                    "Content-Disposition: attachment; filename=\"%s\"\r\nTransfer-Encoding: chunked\r\n\r\n", name);
+    static __thread char buf[65536];
+    size_t n;
+    long long total = 0;
+    bool ok = true;
+    while((n = fread(buf, 1, sizeof(buf), p)) > 0) {
+        char head[16];
+        int hl = snprintf(head, sizeof(head), "%lx\r\n", (unsigned long) n);
+        if(mg_write(conn, head, hl) != hl || mg_write(conn, buf, n) != (int) n || mg_write(conn, "\r\n", 2) != 2) { ok = false; break; }
+        total += n;
+    }
+    if(!ok) while(fread(buf, 1, sizeof(buf), p) > 0) { }     // let the tool finish
+    pclose(p);
+    if(ok) mg_write(conn, "0\r\n\r\n", 5);
+    Debug::out(LOG_INFO, "SystemResource: backup %s sent (%lld bytes%s)", name, total, ok ? "" : ", cut short");
+}
+
+bool SystemResource::receiveFile(mg_connection *conn, const char *tool, long long maxMB, const std::string &fileName, std::string &path)
+{
+    const char *ctype = mg_get_header(conn, "Content-Type");
+    if(!ctype || strncasecmp(ctype, "application/octet-stream", 24) != 0) { sendError(conn, 415, "Content-Type must be application/octet-stream"); return false; }
+    const char *len = mg_get_header(conn, "Content-Length");
+    long long total = len ? atoll(len) : -1;
+    if(total <= 0) { sendError(conn, 411, "Content-Length needed"); return false; }
+    if(total > maxMB * 1024 * 1024) { sendError(conn, 413, "That file is too large."); return false; }
+
+    std::string dir;
+    runToolAt(tool, "workdir", dir);
+    while(!dir.empty() && (dir[dir.length() - 1] == '\n' || dir[dir.length() - 1] == ' ')) dir.erase(dir.length() - 1);
+    struct statvfs fs;
+    if(dir.empty() || dir[0] != '/' || statvfs(dir.c_str(), &fs) != 0) { sendError(conn, 500, "No place for the upload."); return false; }
+    unsigned long long freeBytes = (unsigned long long) fs.f_bavail * fs.f_frsize;
+    // room for the file and for unpacking it next to it
+    if((unsigned long long) total * 3 + 16ULL * 1024 * 1024 > freeBytes) {
+        char b[200];
+        snprintf(b, sizeof(b), "Not enough room: %llu MB free in %s.", freeBytes / 1048576, dir.c_str());
+        sendError(conn, 413, b);
+        return false;
+    }
+    path = dir + "/" + fileName;
+    FILE *f = fopen(path.c_str(), "wb");
+    if(!f) { sendError(conn, 500, std::string("Can't write ") + path + ": " + strerror(errno)); return false; }
+    static __thread char buf[65536];
+    long long got = 0;
+    bool ok = true;
+    while(got < total) {
+        int r = mg_read(conn, buf, sizeof(buf));
+        if(r <= 0) break;
+        if(fwrite(buf, 1, r, f) != (size_t) r) { ok = false; break; }
+        got += r;
+    }
+    if(fflush(f) != 0 || fsync(fileno(f)) != 0) ok = false;
+    fclose(f);
+    if(!ok || got != total) {
+        unlink(path.c_str());
+        sendError(conn, 400, ok ? "The upload was cut short." : "Writing the upload failed (full?).");
+        return false;
+    }
+    return true;
+}
+
+void SystemResource::backupRestore(mg_connection *conn)
+{
+    if(pthread_mutex_trylock(&uploadMutex) != 0) { sendError(conn, 409, "Another upload is running."); return; }
+    std::string path;
+    if(!receiveFile(conn, BACKUP_TOOL, BACKUP_MAX_MB, "restore.tar.gz", path)) { pthread_mutex_unlock(&uploadMutex); return; }
+    bool started = startToolAt(BACKUP_TOOL, "restore '" + path + "' delete");
+    pthread_mutex_unlock(&uploadMutex);
+    if(!started) { unlink(path.c_str()); sendError(conn, 500, "Couldn't start the restore."); return; }
+    usleep(500 * 1000);
+    backupInfo(conn);
+}
