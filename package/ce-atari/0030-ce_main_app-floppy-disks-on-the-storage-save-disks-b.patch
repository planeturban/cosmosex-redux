+bool UnpackCache::isLibraryImage(const std::string &path)
+{
+    size_t slash = path.find_last_of('/');
+    if(slash == std::string::npos) return false;
+    std::string dir = path.substr(0, slash);
+    std::string base = dir.substr(dir.find_last_of('/') + 1);
+    if(base == IMAGE_STORAGE_SUBDIR || base == "img_download") return true;      // the download folders
+    if(dir == IMAGE_STORAGE_RAM_DIR) return true;
+    StorageInfo info;                                   // a download folder set by hand
+    ImageStorage::getStorageInfo(info);
+    return !info.path.empty() && dir == info.path;
+}
