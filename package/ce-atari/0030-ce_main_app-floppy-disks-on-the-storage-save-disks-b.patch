+std::string UnpackCache::contentHash(const std::string &path)
+{
+    FILE *f = fopen(path.c_str(), "rb");
+    if(!f) return "";
+    EVP_MD_CTX *ctx = EVP_MD_CTX_new();
+    if(!ctx || EVP_DigestInit_ex(ctx, EVP_sha256(), NULL) != 1) { if(ctx) EVP_MD_CTX_free(ctx); fclose(f); return ""; }
+    unsigned char buf[65536];
+    size_t n;
+    while((n = fread(buf, 1, sizeof(buf), f)) > 0) EVP_DigestUpdate(ctx, buf, n);
+    bool err = ferror(f) != 0;
+    fclose(f);
+    unsigned char md[EVP_MAX_MD_SIZE];
+    unsigned int mdLen = 0;
+    EVP_DigestFinal_ex(ctx, md, &mdLen);
+    EVP_MD_CTX_free(ctx);
+    if(err || mdLen < 8) return "";
+    char hex[17];
+    for(int i = 0; i < 8; i++) snprintf(hex + i * 2, 3, "%02x", md[i]);
+    return hex;
+}
