From 79e56f7c8ed7694de6568d24393595f2dfd294a9 Mon Sep 17 00:00:00 2001
From: CosmosEx Buildroot <4372835+planeturban@users.noreply.github.com>
Date: Wed, 14 Oct 2026 21:50:52 +0200
Subject: [PATCH 1/2] ce_main_app: clear the whole argv array on 64-bit

memset(argv, 0, 64 * 4) assumed 4-byte pointers; on 64-bit it cleared
only half of char *argv[64]. Use sizeof(argv).
---
 ce_main_app/main.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ce_main_app/main.cpp b/ce_main_app/main.cpp
index 96b29672..1cab58ea 100644
--- a/ce_main_app/main.cpp
+++ b/ce_main_app/main.cpp
@@ -387,7 +387,7 @@ void loadDefaultArgumentsFromFile(void)
 
     int argc = 0;
     char *argv[64];
-    memset(argv, 0, 64 * 4);                    // clear the future argv field
+    memset(argv, 0, sizeof(argv));              // clear the future argv field
 
     argv[0] = (char *) "fake.exe";              // 0th argument is skipped, as it's usualy file name (when passed to main())
     argc    = 1;
