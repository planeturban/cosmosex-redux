+volatile BYTE *ImageList::downloadStatusFor(const std::string &id)
+{
+    int n = (int) (sizeof(downloadSlots) / sizeof(downloadSlots[0]));
+    for(int i=0; i<n; i++) {
+        if(downloadSlots[i].used && downloadSlots[i].id == id) {
+            return &downloadSlots[i].status;
+        }
+    }
+    for(int i=0; i<n; i++) {
+        if(!downloadSlots[i].used) {
+            downloadSlots[i].used   = true;
+            downloadSlots[i].id     = id;
+            downloadSlots[i].status = DWNSTATUS_WAITING;
+            return &downloadSlots[i].status;
+        }
+    }
+    return NULL;        // more ids than slots in one session (sources changed many times): no status
 }
 
