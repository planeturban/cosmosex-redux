+bool Settings::getStringLong(const char *key, std::string &value, const char *defValue)
+{
+	FILE *file = sOpen(key, true);
+	if(!file) {
+		value = defValue;
+		return false;
+	}
+
+	value.clear();
+	char buffer[1024];
+	size_t n;
+	while((n = fread(buffer, 1, sizeof(buffer), file)) > 0) {
+		value.append(buffer, n);
+	}
+	fclose(file);
+
+	if(!value.empty() && value[value.length() - 1] == '\n') {	// strip one trailing newline
+		value.erase(value.length() - 1);
+		if(!value.empty() && value[value.length() - 1] == '\r') {
+			value.erase(value.length() - 1);
+		}
+	}
+	return true;
+}
