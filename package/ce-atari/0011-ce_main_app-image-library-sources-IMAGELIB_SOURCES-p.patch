+    bool anyList    = false;
+    bool anyWeb     = false;
+    DWORD now       = Utils::getCurrentMs();
+
+    for(int i=0; i<(int) sources.size(); i++) {
+        ImageListSource &ls = sources[i];
+        if(!ls.src.enabled || ls.src.type != IMAGELIB_TYPE_WEB) {
+            continue;
+        }
+        anyWeb = true;
+
+        if(Utils::fileExists(ls.cachePath)) {
+            anyList = true;
+            continue;
+        }
+
+        // no list from this source yet: download it, unless that's under way
+        // or was just tried
+        std::string status;
+        getSourceStatus(i, status);
+        if(status == "downloading") {
+            continue;
+        }
+        if(ls.lastAttempt == 0 || (now - ls.lastAttempt) >= IMAGELIST_RETRY_MS) {
+            downloadSource(i);
+        }
+    }
+
+    // no web sources at all: an empty list (nothing to wait for)
+    return anyList || !anyWeb;
+}
