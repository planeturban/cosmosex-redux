diff --git a/ce_main_app/webserver/api/resource/libraryresource.cpp b/ce_main_app/webserver/api/resource/libraryresource.cpp
new file mode 100644
index 00000000..f1b67f10
--- /dev/null
+++ b/ce_main_app/webserver/api/resource/libraryresource.cpp
@@ -0,0 +1,425 @@
+// /api/v1/library/...: the floppy image library for the web UI (see
+// libraryresource.h). All responses are JSON built with cJSON, so list text
+// is escaped properly.
+
+#include "webserver/webserver.h"
+
+#include <string>
+#include <vector>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+
+#include "lib/cjson-code-58/cJSON.h"
+#include "debug.h"
+#include "global.h"
+#include "libraryresource.h"
+#include "service/floppyservice.h"
+#include "../../../floppy/imagelist.h"
+#include "../../../floppy/imagelibsources.h"
+#include "../../../floppy/imagestorage.h"
+#include "../../../floppy/imagesilo.h"
+#include "../../../floppy/floppysetup.h"
+#include "../../../settings.h"
+#include "../../../utils.h"
+#include "../../../periodicthread.h"
+
+extern SharedObjects shared;
+
+#define LIBRARY_MAX_BODY        (16 * 1024)     // 8 sources with long paths fit easily
+#define LIBRARY_MAX_PAGE_SIZE   100
+
+static const char *typeName(int type)
+{
+    switch(type) {
+    case IMAGELIB_TYPE_WEB:     return "web";
+    case IMAGELIB_TYPE_SHARE:   return "share";
+    case IMAGELIB_TYPE_USB:     return "usb";
+    }
+    return "unknown";
+}
+
+static std::string isoTime(time_t t)
+{
+    if(t == 0) {
+        return "";
+    }
+    char buf[32];
+    struct tm tmv;
+    gmtime_r(&t, &tmv);
+    strftime(buf, sizeof(buf), "%Y-%m-%dT%H:%M:%SZ", &tmv);
+    return buf;
+}
+
+LibraryResource::LibraryResource(FloppyService *pxFloppyService) : pxFloppyService(pxFloppyService)
+{
+}
+
+LibraryResource::~LibraryResource()
+{
+}
+
+void LibraryResource::sendJson(mg_connection *conn, cJSON *root, int code)
+{
+    char *json = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    std::string sJson = json ? json : "{}";
+    free(json);
+
+    const char *text = (code == 200) ? "OK" : (code == 400) ? "Bad Request" : (code == 404) ? "Not Found" :
+                       (code == 405) ? "Method Not Allowed" : (code == 413) ? "Payload Too Large" :
+                       (code == 415) ? "Unsupported Media Type" : "Error";
+    mg_printf(conn, "HTTP/1.1 %d %s\r\nContent-Type: application/json\r\nCache-Control: no-cache\r\n", code, text);
+    mg_printf(conn, "Content-Length: %lu\r\n\r\n", (unsigned long) sJson.length());
+    mg_write(conn, sJson.c_str(), sJson.length());
+}
+
+void LibraryResource::sendError(mg_connection *conn, int code, const char *message)
+{
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "status", "error");
+    cJSON_AddStringToObject(root, "error", message);
+    sendJson(conn, root, code);
+}
+
+void LibraryResource::addUsbSticks(cJSON *root)
+{
+    std::vector<UsbStickInfo> sticks;
+    ImageStorage::listUsbSticks(sticks);
+
+    cJSON *arr = cJSON_CreateArray();
+    for(size_t i=0; i<sticks.size(); i++) {
+        cJSON *u = cJSON_CreateObject();
+        char letter[2] = { sticks[i].letter, 0 };
+        cJSON_AddStringToObject(u, "letter",    letter);
+        cJSON_AddStringToObject(u, "device",    sticks[i].device.c_str());
+        cJSON_AddStringToObject(u, "mount",     sticks[i].mount.c_str());
+        cJSON_AddStringToObject(u, "label",     sticks[i].label.c_str());
+        if(sticks[i].serial.empty()) {
+            cJSON_AddNullToObject(u, "serial");             // a stick without a serial number can't be a library source
+        } else {
+            cJSON_AddStringToObject(u, "serial", sticks[i].serial.c_str());
+        }
+        cJSON_AddItemToArray(arr, u);
+    }
+    cJSON_AddItemToObject(root, "usb", arr);
+}
+
+void LibraryResource::onGetSources(mg_connection *conn)
+{
+    ImageList *il = shared.imageList;
+    il->exists();                                   // starts downloads of lists we don't have yet
+    if(!il->getIsLoaded()) {
+        il->loadList();                             // so the entry counts are current
+    }
+
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddNumberToObject(root, "max", IMAGELIB_MAX_SOURCES);
+
+    const std::vector<ImageListSource> &sources = il->getSources();
+    cJSON *arr = cJSON_CreateArray();
+    for(int i=0; i<(int) sources.size(); i++) {
+        const ImageListSource &ls = sources[i];
+        cJSON *s = cJSON_CreateObject();
+
+        std::string status;
+        il->getSourceStatus(i, status);
+
+        cJSON_AddStringToObject(s, "id",        ls.src.id.c_str());
+        cJSON_AddStringToObject(s, "type",      typeName(ls.src.type));
+        cJSON_AddStringToObject(s, "spec",      ls.src.spec.c_str());
+        cJSON_AddBoolToObject(s,   "enabled",   ls.src.enabled);
+        cJSON_AddStringToObject(s, "label",     ls.src.label.c_str());
+        if(ls.src.type == IMAGELIB_TYPE_WEB) {
+            cJSON_AddStringToObject(s, "url",   ls.src.url.c_str());
+        } else {
+            cJSON_AddStringToObject(s, "path",  ls.src.path.c_str());
+            if(ls.src.type == IMAGELIB_TYPE_USB) {
+                cJSON_AddStringToObject(s, "serial", ls.src.serial.c_str());
+            }
+            std::string hostPath;
+            if(ls.src.enabled && ImageStorage::resolveLocation(ls.src.spec, hostPath)) {
+                cJSON_AddStringToObject(s, "resolved", hostPath.c_str());
+            } else {
+                cJSON_AddNullToObject(s, "resolved");       // drive not attached right now
+            }
+        }
+        cJSON_AddStringToObject(s, "status",    status.c_str());
+        cJSON_AddNumberToObject(s, "entries",   ls.entries);
+        cJSON_AddStringToObject(s, "version",   ls.version.c_str());
+        cJSON_AddStringToObject(s, "updated",   isoTime(ls.updated).c_str());
+        cJSON_AddItemToArray(arr, s);
+    }
+    cJSON_AddItemToObject(root, "sources", arr);
+
+    addUsbSticks(root);
+
+    std::string storage;
+    if(shared.imageStorage->getStoragePath(storage)) {
+        cJSON_AddStringToObject(root, "storage", storage.c_str());     // where downloads go
+    } else {
+        cJSON_AddNullToObject(root, "storage");
+    }
+
+    sendJson(conn, root);
+}
+
+void LibraryResource::onPutSources(mg_connection *conn)
+{
+    // JSON only: a cross-site form post can't send this without a CORS preflight
+    const char *ctype = mg_get_header(conn, "Content-Type");
+    if(!ctype || strncasecmp(ctype, "application/json", 16) != 0) {
+        sendError(conn, 415, "Content-Type must be application/json");
+        return;
+    }
+
+    std::string body;
+    char buf[1024];
+    int n;
+    while((n = mg_read(conn, buf, sizeof(buf))) > 0) {
+        body.append(buf, n);
+        if(body.length() > LIBRARY_MAX_BODY) {
+            sendError(conn, 413, "request too large");
+            return;
+        }
+    }
+
+    cJSON *req = cJSON_Parse(body.c_str());
+    if(!req) {
+        sendError(conn, 400, "invalid JSON");
+        return;
+    }
+
+    cJSON *arr = cJSON_GetObjectItem(req, "sources");
+    if(!arr || arr->type != cJSON_Array) {
+        cJSON_Delete(req);
+        sendError(conn, 400, "\"sources\" must be an array");
+        return;
+    }
+
+    int count = cJSON_GetArraySize(arr);
+    if(count > IMAGELIB_MAX_SOURCES) {
+        cJSON_Delete(req);
+        sendError(conn, 400, "at most 8 sources");
+        return;
+    }
+
+    std::vector<ImageLibSource> sources;
+    for(int i=0; i<count; i++) {
+        cJSON *item = cJSON_GetArrayItem(arr, i);
+        cJSON *spec = item ? cJSON_GetObjectItem(item, "spec") : NULL;
+        cJSON *enabled = item ? cJSON_GetObjectItem(item, "enabled") : NULL;
+
+        if(!spec || spec->type != cJSON_String || !spec->valuestring) {
+            cJSON_Delete(req);
+            sendError(conn, 400, "each source needs a \"spec\" string");
+            return;
+        }
+
+        std::string sSpec = spec->valuestring;
+        for(size_t c=0; c<sSpec.length(); c++) {            // one entry per spec: no list separators or line breaks
+            if(sSpec[c] == ',' || sSpec[c] == '\n' || sSpec[c] == '\r') {
+                if(sSpec.compare(0, 6, "share:") == 0 || sSpec.compare(0, 4, "usb:") == 0) {
+                    if(sSpec[c] == ',') continue;           // allowed in paths: joined as %2C
+                }
+                cJSON_Delete(req);
+                std::string msg = "invalid character in source: " + sSpec;
+                sendError(conn, 400, msg.c_str());
+                return;
+            }
+        }
+
+        ImageLibSource src;
+        // a path with a literal comma: parseEntry() expects it as %2C
+        std::string entry = sSpec;
+        if(entry.compare(0, 6, "share:") == 0 || entry.compare(0, 4, "usb:") == 0) {
+            std::string enc;
+            for(size_t c=0; c<entry.length(); c++) {
+                if(entry[c] == ',') enc += "%2C"; else enc += entry[c];
+            }
+            entry = enc;
+        }
+        while(!entry.empty() && (entry[0] == ' ' || entry[0] == '\t')) entry.erase(0, 1);
+        while(!entry.empty() && (entry[entry.length() - 1] == ' ' || entry[entry.length() - 1] == '\t')) entry.erase(entry.length() - 1);
+
+        if(!ImageLibSources::parseEntry(entry, src)) {
+            cJSON_Delete(req);
+            std::string msg = "not a valid source (http(s)://..., share:/path or usb:SERIAL:/path): " + sSpec;
+            sendError(conn, 400, msg.c_str());
+            return;
+        }
+        src.enabled = !(enabled && enabled->type == cJSON_False);
+
+        for(size_t j=0; j<sources.size(); j++) {
+            if(sources[j].id == src.id) {
+                cJSON_Delete(req);
+                std::string msg = "the same source twice: " + sSpec;
+                sendError(conn, 400, msg.c_str());
+                return;
+            }
+        }
+        sources.push_back(src);
+    }
+    cJSON_Delete(req);
+
+    std::string value = ImageLibSources::join(sources);
+    Settings s;
+    s.setString(IMAGELIB_SOURCES_KEY, value.c_str());
+    Utils::forceSync();
+    Debug::out(LOG_INFO, "LibraryResource: %s = %s", IMAGELIB_SOURCES_KEY, value.c_str());
+
+    shared.imageList->refreshList();                // read the new sources, fetch their lists
+
+    onGetSources(conn);                             // answer with the new state
+}
+
+void LibraryResource::onRefresh(mg_connection *conn)
+{
+    shared.imageList->refreshList();
+    onGetSources(conn);
+}
+
+void LibraryResource::onSearch(mg_connection *conn, mg_request_info *req_info)
+{
+    const char *qs = req_info->query_string;
+    int qs_len = qs ? strlen(qs) : 0;
+
+    char q[128] = "", tmp[16], source[80] = "";
+    int page = 0, size = 20;
+    if(qs_len > 0) {
+        mg_get_var(qs, qs_len, "q", q, sizeof(q) - 1);
+        if(mg_get_var(qs, qs_len, "page", tmp, sizeof(tmp) - 1) > 0) page = atoi(tmp);
+        if(mg_get_var(qs, qs_len, "size", tmp, sizeof(tmp) - 1) > 0) size = atoi(tmp);
+        mg_get_var(qs, qs_len, "source", source, sizeof(source) - 1);      // only this source id
+    }
+    if(page < 0) page = 0;
+    if(size < 1) size = 1;
+    if(size > LIBRARY_MAX_PAGE_SIZE) size = LIBRARY_MAX_PAGE_SIZE;
+
+    ImageList *il = shared.imageList;
+    cJSON *root = cJSON_CreateObject();
+
+    // the slots, so the page can show what's inserted
+    cJSON *slots = cJSON_CreateArray();
+    for(int i=0; i<3; i++) {
+        cJSON_AddItemToArray(slots, cJSON_CreateString(pxFloppyService->getImageName(i).c_str()));
+    }
+    cJSON_AddItemToObject(root, "slots", slots);
+    cJSON_AddBoolToObject(root, "storage", shared.imageStorage->doWeHaveStorage());
+
+    if(!il->exists()) {                             // no list yet: downloading
+        cJSON_AddStringToObject(root, "status", "downloading");
+        cJSON_AddNumberToObject(root, "total", 0);
+        cJSON_AddItemToObject(root, "results", cJSON_CreateArray());
+        sendJson(conn, root);
+        return;
+    }
+
+    std::vector<int> found;
+    il->searchImages(q, found);
+
+    const std::vector<ImageListSource> &sources = il->getSources();
+    if(source[0]) {
+        std::vector<int> filtered;
+        for(size_t i=0; i<found.size(); i++) {
+            const ImageListItem *img = il->getImage(found[i]);
+            if(img && img->sourceIndex >= 0 && img->sourceIndex < (int) sources.size() &&
+               sources[img->sourceIndex].src.id == source) {
+                filtered.push_back(found[i]);
+            }
+        }
+        found.swap(filtered);
+    }
+
+    int total = (int) found.size();
+    int pages = (total + size - 1) / size;
+    if(page >= pages && pages > 0) page = pages - 1;
+
+    cJSON_AddStringToObject(root, "status", il->getIsLoaded() ? "ok" : "not_loaded");
+    cJSON_AddNumberToObject(root, "total", total);
+    cJSON_AddNumberToObject(root, "page", page);
+    cJSON_AddNumberToObject(root, "pages", pages);
+    cJSON_AddNumberToObject(root, "size", size);
+
+    cJSON *results = cJSON_CreateArray();
+    for(int r = page * size; r < total && r < (page + 1) * size; r++) {
+        const ImageListItem *img = il->getImage(found[r]);
+        if(!img) continue;
+
+        cJSON *o = cJSON_CreateObject();
+        cJSON_AddStringToObject(o, "image", img->imageName.c_str());
+
+        cJSON *games = cJSON_CreateArray();             // the games on this image, original case
+        size_t start = 0;
+        const std::string &g = img->gamesDisplay;
+        while(start <= g.length()) {
+            size_t comma = g.find(',', start);
+            if(comma == std::string::npos) comma = g.length();
+            std::string one = g.substr(start, comma - start);
+            while(!one.empty() && one[0] == ' ') one.erase(0, 1);
+            while(!one.empty() && one[one.length() - 1] == ' ') one.erase(one.length() - 1);
+            if(!one.empty()) cJSON_AddItemToArray(games, cJSON_CreateString(one.c_str()));
+            start = comma + 1;
+        }
+        cJSON_AddItemToObject(o, "games", games);
+
+        if(img->sourceIndex >= 0 && img->sourceIndex < (int) sources.size()) {
+            cJSON_AddStringToObject(o, "sourceId", sources[img->sourceIndex].src.id.c_str());
+            cJSON_AddStringToObject(o, "source", sources[img->sourceIndex].src.label.c_str());
+        }
+
+        cJSON_AddBoolToObject(o, "haveIt", shared.imageStorage->weHaveThisImage(img->imageName.c_str()));
+
+        char inSlots[3];
+        std::string name = img->imageName;
+        shared.imageSilo->containsImageInSlots(name, inSlots);
+        cJSON *slotArr = cJSON_CreateArray();
+        for(int i=0; i<3; i++) {
+            if(inSlots[i] == ROW_OBJ_SELECTED) cJSON_AddItemToArray(slotArr, cJSON_CreateNumber(i));
+        }
+        cJSON_AddItemToObject(o, "inSlots", slotArr);
+
+        cJSON_AddItemToArray(results, o);
+    }
+    cJSON_AddItemToObject(root, "results", results);
+
+    sendJson(conn, root);
+}
+
+void LibraryResource::onGetUsb(mg_connection *conn)
+{
+    cJSON *root = cJSON_CreateObject();
+    addUsbSticks(root);
+    sendJson(conn, root);
+}
+
+bool LibraryResource::dispatch(mg_connection *conn, mg_request_info *req_info, std::string sResourceInfo)
+{
+    const char *m = req_info->request_method;
+    std::string path = sResourceInfo;
+    size_t q = path.find('?');
+    if(q != std::string::npos) path.erase(q);
+
+    pthread_mutex_lock(&shared.mtxImages);      // image list, storage and silo are shared with the core thread
+
+    if(path == "sources" && strcmp(m, "GET") == 0) {
+        onGetSources(conn);
+    } else if(path == "sources" && strcmp(m, "PUT") == 0) {
+        onPutSources(conn);
+    } else if(path == "refresh" && strcmp(m, "POST") == 0) {
+        onRefresh(conn);
+    } else if(path == "search" && strcmp(m, "GET") == 0) {
+        onSearch(conn, req_info);
+    } else if(path == "usb" && strcmp(m, "GET") == 0) {
+        onGetUsb(conn);
+    } else if(path == "sources" || path == "refresh" || path == "search" || path == "usb") {
+        sendError(conn, 405, "method not allowed");
+    } else {
+        sendError(conn, 404, "unknown library resource");
+    }
+
+    pthread_mutex_unlock(&shared.mtxImages);
+    return true;
+}
