+void ImageStorage::listUsbSticks(std::vector<UsbStickInfo> &sticks)
+{
+    sticks.clear();
+
+    TranslatedDisk *translated = TranslatedDisk::getInstance();
+    if(!translated) {
+        return;
+    }
+
+    std::vector<TranslatedUsbDrive> drives;
+    translated->mutexLock();
+    translated->getUsbDrives(drives);
+    translated->mutexUnlock();
+
+    for(size_t i=0; i<drives.size(); i++) {
+        UsbStickInfo u;
+        u.letter = drives[i].stDriveLetter;
+        u.device = drives[i].devicePath;
+        u.mount  = drives[i].hostRootPath;
+        u.label  = drives[i].label;
+        usbSerialForBlockDevice(u.device, u.serial);
+        sticks.push_back(u);
+    }
+}
+
+bool ImageStorage::findMountForUsbSerial(const std::string &serial, std::string &mountPath)
+{
+    mountPath.clear();
+
+    std::vector<UsbStickInfo> sticks;
+    listUsbSticks(sticks);
+
+    for(size_t i=0; i<sticks.size(); i++) {
+        if(!sticks[i].serial.empty() && sticks[i].serial == serial) {
+            mountPath = sticks[i].mount;            // first partition of that stick that is attached
+            return true;
+        }
+    }
+    return false;
+}
+
+bool ImageStorage::resolveLocation(const std::string &spec, std::string &hostPath)
+{
+    hostPath.clear();
+
+    int type;
+    std::string serial, path, root;
+    if(!ImageLibSources::parseLocation(spec, type, serial, path)) {
+        Debug::out(LOG_ERROR, "ImageStorage::resolveLocation() - invalid location: %s", spec.c_str());
+        return false;
+    }
+
+    if(type == IMAGELIB_TYPE_SHARE) {
+        TranslatedDisk *translated = TranslatedDisk::getInstance();
+        bool ok = false;
+        if(translated) {
+            translated->mutexLock();
+            ok = translated->getSharedDrivePath(root);
+            translated->mutexUnlock();
+        }
+        if(!ok) {
+            Debug::out(LOG_DEBUG, "ImageStorage::resolveLocation() - %s: the shared drive isn't available", spec.c_str());
+            return false;
+        }
+    } else {
+        if(!findMountForUsbSerial(serial, root)) {
+            Debug::out(LOG_DEBUG, "ImageStorage::resolveLocation() - %s: no USB drive with serial %s attached", spec.c_str(), serial.c_str());
+            return false;
+        }
+    }
+
+    hostPath = root;
+    Utils::mergeHostPaths(hostPath, path);
+    return true;
+}
