+
+void ImageList::getSourceStatus(int index, std::string &status)
+{
+    if(index < 0 || index >= (int) sources.size()) {
+        status = "unknown";
+        return;
+    }
+
+    ImageListSource &ls = sources[index];
+    if(!ls.src.enabled) {
+        status = "disabled";
+        return;
+    }
+    if(ls.src.type != IMAGELIB_TYPE_WEB) {
+        status = "not_loaded";          // share: and usb: sources are loaded from stage 6.2 on
+        return;
+    }
+
+    volatile BYTE *st = downloadStatusFor(ls.src.id);
+    int result = ls.lastResult;
+    if(result != -1 && st) {
+        result = *st;
+    }
+
+    bool haveCache = Utils::fileExists(ls.cachePath);
+
+    if(result == DWNSTATUS_WAITING || result == DWNSTATUS_DOWNLOADING || result == DWNSTATUS_VERIFYING) {
+        status = "downloading";
+    } else if(result == DWNSTATUS_DOWNLOAD_FAIL) {
+        status = haveCache ? "offline" : "unavailable";     // offline: using the last list we got
+    } else {
+        status = haveCache ? "online" : "unavailable";
+    }
+}
