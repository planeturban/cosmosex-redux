+        }
+        std::string name = vectorOfImages[i].imageName;
+        std::transform(name.begin(), name.end(), name.begin(), ::tolower);
+        if(vectorOfImages[i].games.find(sPart) != std::string::npos || name.find(sPart) != std::string::npos) {
+            imageIndexes.push_back(i);
+        }
+    }
+}
