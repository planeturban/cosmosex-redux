+#ifndef _IMAGELIBSOURCES_H_
+#define _IMAGELIBSOURCES_H_
+
+// Floppy image library sources: the IMAGELIB_SOURCES setting.
+//
+// A comma-separated, ordered list (first = highest priority) of:
+//   http://... / https://...   a remote imagelist.csv (the original list or a mirror)
+//   share:<path>               a folder on the shared drive
+//   usb:<serial>:<path>        a folder on the USB stick with this USB serial number
+// An entry starting with '!' is disabled: kept in place, but not used.
+// A comma inside a share:/usb: path is written as %2C (decoded); URLs are
+// passed through unchanged. Empty entries are ignored, unknown ones skipped,
+// at most IMAGELIB_MAX_SOURCES entries (disabled ones count).
+//
+// This file has no dependencies on the rest of the app (unit-tested on the
+// build host).
+
+#include <string>
+#include <vector>
+
+#define IMAGELIB_SOURCES_KEY        "IMAGELIB_SOURCES"
+#define IMAGELIB_DEFAULT_SOURCE     "http://joo.kie.sk/cosmosex/update/imagelist.csv"
+#define IMAGELIB_MAX_SOURCES        8
+
+#define IMAGELIB_TYPE_WEB           0
+#define IMAGELIB_TYPE_SHARE         1
+#define IMAGELIB_TYPE_USB           2
+
+typedef struct {
+    int         type;       // IMAGELIB_TYPE_*
+    bool        enabled;    // false: entry had the '!' prefix
+    std::string spec;       // the entry as configured, without '!' (e.g. "usb:4C53:/atari")
+    std::string url;        // web: the list URL
+    std::string serial;     // usb: the USB serial number
+    std::string path;       // share/usb: folder, %2C decoded, starts with '/'
+    std::string id;         // stable short id, [A-Za-z0-9._-] (file names, save paths)
+    std::string label;      // for the UI, e.g. "WEB joo.kie.sk", "SHARE /atari", "USB 4C53..."
+} ImageLibSource;
+
+class ImageLibSources
+{
+public:
+    // Parses the setting value. Problems (unknown entries, too many) are
+    // appended to warnings, if given. Returns the number of sources.
+    static int  parse(const std::string &value, std::vector<ImageLibSource> &sources, std::vector<std::string> *warnings = NULL);
+
+    // Parses one entry (without '!'); false if it isn't a valid source.
+    static bool parseEntry(const std::string &entry, ImageLibSource &src);
+
+    // The setting value for these sources (inverse of parse()).
+    static std::string join(const std::vector<ImageLibSource> &sources);
+
+    // "share:/a/b" / "usb:SERIAL:/a/b": type, serial and path (decoded).
+    // Used for IMAGELIB_SOURCES, IMAGE_STORAGE and FLOPPY_SAVES.
+    static bool parseLocation(const std::string &spec, int &type, std::string &serial, std::string &path);
+
+    // Host part of an http(s) URL ("" if none).
+    static std::string urlHost(const std::string &url);
+
+    static std::string sanitizeId(const std::string &s);
+    static std::string shortHash(const std::string &s);     // 6 hex chars (FNV-1a)
+
+private:
+    static std::string trim(const std::string &s);
+    static std::string decodeComma(const std::string &s);
+    static std::string encodeComma(const std::string &s);
+};
+
+#endif
