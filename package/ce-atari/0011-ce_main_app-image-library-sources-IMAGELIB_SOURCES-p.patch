+std::string ImageList::cacheSignature(void)
+{
+    std::ostringstream sig;
+    for(size_t i=0; i<sources.size(); i++) {
+        if(!sources[i].src.enabled || sources[i].src.type != IMAGELIB_TYPE_WEB) {
+            continue;
+        }
+        struct stat st;
+        sig << sources[i].src.id << ":";
+        if(stat(sources[i].cachePath.c_str(), &st) == 0) {
+            sig << (long) st.st_size << "/" << (long) st.st_mtime;
+        }
+        sig << ";";
+    }
+    return sig.str();
