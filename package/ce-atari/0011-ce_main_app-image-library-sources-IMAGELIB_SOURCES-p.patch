+// Floppy image library sources: parsing and joining IMAGELIB_SOURCES.
+// See imagelibsources.h. No dependencies on the rest of the app.
+
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "imagelibsources.h"
+
+std::string ImageLibSources::trim(const std::string &s)
+{
+    size_t a = 0, b = s.length();
+    while(a < b && isspace((unsigned char) s[a])) a++;
+    while(b > a && isspace((unsigned char) s[b - 1])) b--;
+    return s.substr(a, b - a);
+}
+
+// "%2C" (either case) -> ","; nothing else is decoded
+std::string ImageLibSources::decodeComma(const std::string &s)
+{
+    std::string out;
+    for(size_t i = 0; i < s.length(); i++) {
+        if(s[i] == '%' && i + 2 < s.length() &&
+           s[i + 1] == '2' && (s[i + 2] == 'C' || s[i + 2] == 'c')) {
+            out += ',';
+            i += 2;
+        } else {
+            out += s[i];
+        }
+    }
+    return out;
+}
+
+std::string ImageLibSources::encodeComma(const std::string &s)
+{
+    std::string out;
+    for(size_t i = 0; i < s.length(); i++) {
+        if(s[i] == ',') out += "%2C";
+        else            out += s[i];
+    }
+    return out;
+}
+
+std::string ImageLibSources::shortHash(const std::string &s)
+{
+    uint32_t h = 2166136261u;                   // FNV-1a, 32 bit
+    for(size_t i = 0; i < s.length(); i++) {
+        h ^= (unsigned char) s[i];
+        h *= 16777619u;
+    }
+    char buf[16];
+    snprintf(buf, sizeof(buf), "%06x", (unsigned) (h & 0xffffff));
+    return std::string(buf);
+}
+
+std::string ImageLibSources::sanitizeId(const std::string &s)
+{
+    std::string out;
+    for(size_t i = 0; i < s.length() && out.length() < 64; i++) {
+        char c = s[i];
+        if(isalnum((unsigned char) c) || c == '.' || c == '_' || c == '-') out += c;
+        else                                                              out += '_';
+    }
+    return out;
+}
+
+std::string ImageLibSources::urlHost(const std::string &url)
+{
+    size_t p = url.find("://");
+    if(p == std::string::npos) return "";
+    p += 3;
+    size_t e = url.find_first_of("/?#", p);
+    std::string host = url.substr(p, e == std::string::npos ? std::string::npos : e - p);
+    size_t at = host.rfind('@');                // drop user:password@
+    if(at != std::string::npos) host = host.substr(at + 1);
+    return host;
+}
+
+static bool startsWith(const std::string &s, const char *prefix)
+{
+    return s.compare(0, strlen(prefix), prefix) == 0;
+}
+
+static bool startsWithNoCase(const std::string &s, const char *prefix)
+{
+    size_t n = strlen(prefix);
+    if(s.length() < n) return false;
+    for(size_t i = 0; i < n; i++) {
+        if(tolower((unsigned char) s[i]) != tolower((unsigned char) prefix[i])) return false;
+    }
+    return true;
+}
+
+bool ImageLibSources::parseLocation(const std::string &spec, int &type, std::string &serial, std::string &path)
+{
+    serial.clear();
+    path.clear();
+
+    std::string rest;
+    if(startsWith(spec, "share:")) {
+        type = IMAGELIB_TYPE_SHARE;
+        rest = spec.substr(6);
+    } else if(startsWith(spec, "usb:")) {
+        type = IMAGELIB_TYPE_USB;
+        size_t colon = spec.find(':', 4);
+        if(colon == std::string::npos) return false;            // usb:<serial>:<path>
+        serial = trim(spec.substr(4, colon - 4));
+        if(serial.empty()) return false;
+        for(size_t i = 0; i < serial.length(); i++) {           // serials: printable, no '/' (used in ids, compared with sysfs)
+            unsigned char c = serial[i];
+            if(c < 0x21 || c > 0x7e || c == '/' || c == ',') return false;
+        }
+        rest = spec.substr(colon + 1);
+    } else {
+        return false;
+    }
+
+    path = decodeComma(trim(rest));
+    if(path.empty() || path[0] != '/') path = "/" + path;
+    while(path.length() > 1 && path[path.length() - 1] == '/') path.erase(path.length() - 1);
+
+    // no ".." components: a library folder can't point outside its drive
+    std::string p = path + "/";
+    if(p.find("/../") != std::string::npos) return false;
+    return true;
+}
+
+bool ImageLibSources::parseEntry(const std::string &entry, ImageLibSource &src)
+{
+    src.enabled = true;
+    src.spec    = entry;
+    src.url.clear();
+    src.serial.clear();
+    src.path.clear();
+
+    if(startsWithNoCase(entry, "http://") || startsWithNoCase(entry, "https://")) {
+        std::string host = urlHost(entry);
+        if(host.empty()) return false;
+        src.type  = IMAGELIB_TYPE_WEB;
+        src.url   = entry;
+        src.id    = sanitizeId(host + "-" + shortHash(entry));
+        src.label = "WEB " + host;
+        return true;
+    }
+
+    int type;
+    if(!parseLocation(entry, type, src.serial, src.path)) return false;
+    src.type = type;
+
+    if(type == IMAGELIB_TYPE_SHARE) {
+        src.id    = "share-" + shortHash(src.path);
+        src.label = "SHARE " + src.path;
+    } else {
+        src.id    = sanitizeId("usb-" + src.serial);
+        std::string shortSerial = src.serial.length() > 8 ? src.serial.substr(0, 8) + "..." : src.serial;
+        src.label = "USB " + shortSerial + " " + src.path;
+    }
+    return true;
+}
+
+int ImageLibSources::parse(const std::string &value, std::vector<ImageLibSource> &sources, std::vector<std::string> *warnings)
+{
+    sources.clear();
+
+    size_t start = 0;
+    while(start <= value.length()) {
+        size_t comma = value.find(',', start);
+        if(comma == std::string::npos) comma = value.length();
+
+        std::string entry = trim(value.substr(start, comma - start));
+        start = comma + 1;
+
+        if(entry.empty()) continue;                             // e.g. a trailing comma
+
+        bool enabled = true;
+        if(entry[0] == '!') {
+            enabled = false;
+            entry = trim(entry.substr(1));
+            if(entry.empty()) continue;
+        }
+
+        ImageLibSource src;
+        if(!parseEntry(entry, src)) {
+            if(warnings) warnings->push_back("unknown image library source skipped: " + entry);
+            continue;
+        }
+        src.enabled = enabled;
+
+        if((int) sources.size() >= IMAGELIB_MAX_SOURCES) {
+            if(warnings) warnings->push_back("more than 8 image library sources, ignored: " + entry);
+            continue;
+        }
+
+        // two entries with the same id (e.g. the same URL twice): keep the first
+        bool dup = false;
+        for(size_t i = 0; i < sources.size(); i++) {
+            if(sources[i].id == src.id) dup = true;
+        }
+        if(dup) {
+            if(warnings) warnings->push_back("duplicate image library source ignored: " + entry);
+            continue;
+        }
+
+        sources.push_back(src);
+    }
+    return (int) sources.size();
+}
+
+std::string ImageLibSources::join(const std::vector<ImageLibSource> &sources)
+{
+    std::string out;
+    for(size_t i = 0; i < sources.size(); i++) {
+        const ImageLibSource &s = sources[i];
+        std::string entry;
+        if(s.type == IMAGELIB_TYPE_WEB)        entry = s.url;
+        else if(s.type == IMAGELIB_TYPE_SHARE) entry = "share:" + encodeComma(s.path);
+        else                                   entry = "usb:" + s.serial + ":" + encodeComma(s.path);
+
+        if(!out.empty()) out += ", ";
+        if(!s.enabled) out += "!";
+        out += entry;
+    }
+    return out;
+}
