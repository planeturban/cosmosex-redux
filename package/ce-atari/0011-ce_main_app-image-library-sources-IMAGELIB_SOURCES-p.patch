diff --git a/ce_main_app/usbserial.cpp b/ce_main_app/usbserial.cpp
new file mode 100644
index 00000000..6976d286
--- /dev/null
+++ b/ce_main_app/usbserial.cpp
@@ -0,0 +1,78 @@
+// USB serial number of a block device, from sysfs. See usbserial.h.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <limits.h>
+#include <unistd.h>
+
+#include "usbserial.h"
+
+std::string usbBlockDiskName(const std::string &devicePath)
+{
+    std::string name = devicePath;
+    size_t slash = name.rfind('/');
+    if(slash != std::string::npos) name = name.substr(slash + 1);
+
+    if(name.compare(0, 6, "mmcblk") == 0 || name.compare(0, 4, "nvme") == 0) {
+        size_t p = name.find('p', 4);                   // mmcblk0p1 -> mmcblk0
+        if(p != std::string::npos && p + 1 < name.length() && isdigit((unsigned char) name[p + 1])) {
+            name = name.substr(0, p);
+        }
+        return name;
+    }
+
+    while(!name.empty() && isdigit((unsigned char) name[name.length() - 1])) {   // sda1 -> sda
+        name.erase(name.length() - 1);
+    }
+    return name;
+}
+
+static bool readFirstLine(const std::string &path, std::string &out)
+{
+    FILE *f = fopen(path.c_str(), "r");
+    if(!f) return false;
+
+    char buf[256];
+    memset(buf, 0, sizeof(buf));
+    char *r = fgets(buf, sizeof(buf), f);
+    fclose(f);
+    if(!r) return false;
+
+    out = buf;
+    while(!out.empty() && (out[out.length() - 1] == '\n' || out[out.length() - 1] == '\r' || out[out.length() - 1] == ' ')) {
+        out.erase(out.length() - 1);
+    }
+    return true;
+}
+
+bool usbSerialForBlockDevice(const std::string &devicePath, std::string &serial, const char *sysRoot)
+{
+    serial.clear();
+
+    std::string disk = usbBlockDiskName(devicePath);
+    if(disk.empty()) return false;
+
+    std::string link = std::string(sysRoot) + "/block/" + disk + "/device";
+    char real[PATH_MAX];
+    if(!realpath(link.c_str(), real)) return false;
+
+    std::string root = std::string(sysRoot) + "/devices";
+    char realRoot[PATH_MAX];
+    if(realpath(root.c_str(), realRoot)) root = realRoot;
+
+    std::string dir = real;
+    while(dir.length() > root.length() && dir.compare(0, root.length(), root) == 0) {
+        std::string s, vendor;
+        if(readFirstLine(dir + "/serial", s) && readFirstLine(dir + "/idVendor", vendor)) {
+            if(s.empty()) return false;                 // USB device without a serial number
+            serial = s;
+            return true;
+        }
+        size_t slash = dir.rfind('/');
+        if(slash == std::string::npos || slash == 0) break;
+        dir.erase(slash);
+    }
+    return false;
+}
diff --git a/ce_main_app/usbserial.h b/ce_main_app/usbserial.h
new file mode 100644
index 00000000..1f765d9c
--- /dev/null
+++ b/ce_main_app/usbserial.h
@@ -0,0 +1,17 @@
+#ifndef _USBSERIAL_H_
+#define _USBSERIAL_H_
+
+#include <string>
+
+// The USB serial number of the USB device a block device belongs to, read
+// from sysfs (works without udev / /dev/disk/by-id):
+//   /dev/sda1 -> /sys/block/sda/device -> realpath -> walk up the parents
+//   until a USB device directory (has both "serial" and "idVendor").
+// sysRoot is "/sys" except in unit tests. No dependencies on the rest of
+// the app.
+bool usbSerialForBlockDevice(const std::string &devicePath, std::string &serial, const char *sysRoot = "/sys");
+
+// "/dev/sda1" -> "sda", "/dev/sdb" -> "sdb", "/dev/mmcblk0p1" -> "mmcblk0"
+std::string usbBlockDiskName(const std::string &devicePath);
+
+#endif
