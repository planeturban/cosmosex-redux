From 4a5e4efbfdbd1447673b61b75b28ceb099e94d35 Mon Sep 17 00:00:00 2001
From: CosmosEx Buildroot <4372835+planeturban@users.noreply.github.com>
Date: Sun, 15 Nov 2026 12:18:58 +0100
Subject: [PATCH] ce_main_app: downloader: follow HTTP redirects

The downloader didn't follow redirects, so a moved file was saved as the
server's "301 Moved Permanently" page. Floppy images in the current
upstream image list on exxosforum.co.uk now redirect to
www.exxosforum.co.uk: every such download "worked" but gave a 162-byte
HTML page instead of the zip (and the insert failed). Follow up to 5
redirects, to http/https only.

Also tell a download that isn't a zip at all apart from a zip without a
disk image in the log.
---
 ce_main_app/downloader.cpp | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/ce_main_app/downloader.cpp b/ce_main_app/downloader.cpp
index 0cd3af4f..7eed8195 100644
--- a/ce_main_app/downloader.cpp
+++ b/ce_main_app/downloader.cpp
@@ -262,7 +262,10 @@ bool Downloader::finishFloppyDownload(const std::string &tmpFile, const std::str
         UnpackCache::removeTree(unzDir);
         mkdir(unzDir.c_str(), 0755);
         std::string image;
-        if(!UnpackCache::runUnzip(tmpFile, unzDir) || !UnpackCache::findFirstImage(unzDir, image)) {
+        if(!UnpackCache::runUnzip(tmpFile, unzDir)) {
+            Debug::out(LOG_ERROR, "Downloader - %s: what the server sent isn't a zip file (%s)", downloadCurrent.srcUrl.c_str(), finalFile.c_str());
+            ok = false;
+        } else if(!UnpackCache::findFirstImage(unzDir, image)) {
             Debug::out(LOG_ERROR, "Downloader - no .st / .msa image in the downloaded zip %s", finalFile.c_str());
             ok = false;
         } else {
@@ -611,6 +614,12 @@ void Downloader::run(void)
         curl_easy_setopt(curl, CURLOPT_PROGRESSFUNCTION,    my_progress_func);
         curl_easy_setopt(curl, CURLOPT_PROGRESSDATA,        &downloadCurrent);
         curl_easy_setopt(curl, CURLOPT_FAILONERROR,         true);
+        // Follow redirects (e.g. exxosforum.co.uk -> www.exxosforum.co.uk,
+        // where many library images are): without this the "moved" page was
+        // saved as the image. Only to http/https, at most 5.
+        curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION,      1L);
+        curl_easy_setopt(curl, CURLOPT_MAXREDIRS,           5L);
+        curl_easy_setopt(curl, CURLOPT_REDIR_PROTOCOLS_STR, "http,https");
 
         cres = curl_easy_perform(curl);                      // start the transfer
 
