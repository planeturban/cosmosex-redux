+#ifndef PISHARE_H
+#define PISHARE_H
+
+// /pi sharing (NFS and SMB) for GET/PUT /api/v1/settings/pishare: the settings
+// file PISHARE_CONF, applied by the image's PISHARE_TOOL (Buildroot image:
+// /usr/sbin/ce-pishare). Without the tool the section reports "available":
+// false and refuses changes.
+
+#include <string>
+
+struct cJSON;
+
+#define PISHARE_CONF    "/etc/ce-pishare.conf"
+#define PISHARE_TOOL    "/usr/sbin/ce-pishare"
+
+bool pishareBuild(cJSON *out);
+bool pishareSave(cJSON *in, std::string &msg);
+
+#endif
