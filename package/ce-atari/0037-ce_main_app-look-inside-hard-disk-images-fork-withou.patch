 // null) to keep them, send "" to clear.
@@ -38,6 +40,7 @@ private:
     bool saveSection(const std::string &name, cJSON *in, std::string &message, std::string &warning);
 
     void downloadImage(mg_connection *conn, mg_request_info *req_info);
+    void inspectImage(mg_connection *conn, mg_request_info *req_info, bool file);
     void sendJson(mg_connection *conn, cJSON *root, int code = 200);
     void sendError(mg_connection *conn, int code, const char *message);
 };
diff --git a/ce_main_app/webserver/api/resource/systemresource.cpp b/ce_main_app/webserver/api/resource/systemresource.cpp
index 3e7f0be5..09c7be08 100644
--- a/ce_main_app/webserver/api/resource/systemresource.cpp
+++ b/ce_main_app/webserver/api/resource/systemresource.cpp
@@ -65,6 +65,7 @@ static std::string valueOf(const std::string &kv, const char *key)
 // CosmosEx). Double fork, so no zombie; no inherited sockets.
 static bool startToolAt(const char *tool, const std::string &args)
 {
+    std::string cmd = std::string(tool) + " " + args;      // before fork: the child mustn't allocate (other threads)
     pid_t pid = fork();
     if(pid < 0) return false;
     if(pid == 0) {
@@ -75,7 +76,6 @@ static bool startToolAt(const char *tool, const std::string &args)
         int nul = open("/dev/null", O_RDWR);
         if(nul >= 0) { dup2(nul, 0); dup2(nul, 1); dup2(nul, 2); if(nul > 2) close(nul); }
         signal(SIGPIPE, SIG_DFL);
-        std::string cmd = std::string(tool) + " " + args;
         execl("/bin/sh", "sh", "-c", cmd.c_str(), (char *) NULL);
         _exit(127);
     }
