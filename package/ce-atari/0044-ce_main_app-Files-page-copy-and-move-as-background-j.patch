From fb19e87954f22b08a0a43acb9f13d5829d872ce2 Mon Sep 17 00:00:00 2001
From: CosmosEx Buildroot <4372835+planeturban@users.noreply.github.com>
Date: Tue, 17 Nov 2026 23:51:24 +0100
Subject: [PATCH] ce_main_app: Files page: copy and move as background jobs,
 conflicts, read the start of a file

POST /api/v1/files/copy {op: copy|move, from, to, names, replace} starts a
job (ce-files job-start: one at a time, in the background, so a big copy
doesn't depend on the browser); GET /api/v1/files/job its progress, POST
/api/v1/files/job/cancel; POST /api/v1/files/conflicts the names already
at the target (as they'd be stored there) so the page can ask first;
GET /api/v1/files/read?...&max=<bytes> only the start (the file viewer).
---
 .../webserver/api/resource/filesresource.cpp  | 113 +++++++++++++++++-
 .../webserver/api/resource/filesresource.h    |  10 ++
 2 files changed, 122 insertions(+), 1 deletion(-)

diff --git a/ce_main_app/webserver/api/resource/filesresource.cpp b/ce_main_app/webserver/api/resource/filesresource.cpp
index a4b83299..760899f3 100644
--- a/ce_main_app/webserver/api/resource/filesresource.cpp
+++ b/ce_main_app/webserver/api/resource/filesresource.cpp
@@ -316,6 +316,8 @@ void FilesResource::download(mg_connection *conn, const char *qs, bool zip)
         std::string file = getVar(qs, "file");
         if(file.empty()) { sendError(conn, 400, "which file?"); return; }
         args.push_back("cat"); args.push_back(place); args.push_back(file);
+        std::string max = getVar(qs, "max");
+        if(!max.empty() && max.find_first_not_of("0123456789") == std::string::npos) args.push_back(max);
         name = file.substr(file.find_last_of('/') + 1);
     }
     std::string headers = std::string("HTTP/1.1 200 OK\r\nContent-Type: ") + (zip ? "application/zip" : "application/octet-stream") +
@@ -399,6 +401,113 @@ void FilesResource::change(mg_connection *conn, const std::string &what)
     sendJson(conn, root);
 }
 
+static std::string jsonDir(cJSON *o, const char *key, const char *field)
+{
+    cJSON *x = o ? cJSON_GetObjectItem(o, key) : NULL;
+    cJSON *v = x ? cJSON_GetObjectItem(x, field) : NULL;
+    return (v && v->type == cJSON_String && v->valuestring) ? v->valuestring : "";
+}
+
+// copy, conflicts (JSON body), job (GET), job/cancel
+void FilesResource::job(mg_connection *conn, const std::string &what)
+{
+    std::vector<std::string> args;
+    args.push_back(FILES_TOOL);
+    std::string out;
+    if(what == "job") {
+        args.push_back("job-status");
+        int rc = runTool(args, out, NULL, 0, NULL, "", NULL);
+        if(rc != 0) { sendToolError(conn, rc, out); return; }
+        cJSON *root = cJSON_CreateObject();
+        const char *strs[] = { "state", "op", "current", "message", NULL };
+        const char *nums[] = { "totalBytes", "doneBytes", "totalFiles", "doneFiles", "skipped", "started", NULL };
+        for(int i = 0; strs[i]; i++) cJSON_AddStringToObject(root, strs[i], lineValue(out, strs[i]).c_str());
+        for(int i = 0; nums[i]; i++) cJSON_AddNumberToObject(root, nums[i], atof(lineValue(out, nums[i]).c_str()));
+        cJSON *ren = cJSON_CreateArray();
+        std::string r = lineValue(out, "renamed");
+        size_t a = 0;
+        while(!r.empty() && a <= r.length()) {
+            size_t b = r.find('|', a);
+            if(b == std::string::npos) b = r.length();
+            std::string one = r.substr(a, b - a);
+            size_t arrow = one.find(" -> ");
+            if(arrow != std::string::npos) {
+                cJSON *o = cJSON_CreateObject();
+                cJSON_AddStringToObject(o, "from", one.substr(0, arrow).c_str());
+                cJSON_AddStringToObject(o, "to", one.substr(arrow + 4).c_str());
+                cJSON_AddItemToArray(ren, o);
+            }
+            a = b + 1;
+        }
+        cJSON_AddItemToObject(root, "renamed", ren);
+        sendJson(conn, root);
+        return;
+    }
+    const char *ctype = mg_get_header(conn, "Content-Type");
+    if(!ctype || strncasecmp(ctype, "application/json", 16) != 0) { sendError(conn, 415, "Content-Type must be application/json"); return; }
+    std::string body;
+    char b[1024];
+    int n;
+    while((n = mg_read(conn, b, sizeof(b))) > 0) if(body.length() < (1u << 20)) body.append(b, n);
+    if(what == "job/cancel") {
+        args.push_back("job-cancel");
+        runTool(args, out, NULL, 0, NULL, "", NULL);
+        cJSON *root = cJSON_CreateObject();
+        cJSON_AddBoolToObject(root, "cancelled", true);
+        sendJson(conn, root);
+        return;
+    }
+    cJSON *in = cJSON_Parse(body.c_str());
+    if(!in) { sendError(conn, 400, "bad JSON"); return; }
+    std::vector<std::string> names;
+    cJSON *jn = cJSON_GetObjectItem(in, "names");
+    int count = jn && jn->type == cJSON_Array ? cJSON_GetArraySize(jn) : 0;
+    for(int i = 0; i < count && i < 10000; i++) {
+        cJSON *x = cJSON_GetArrayItem(jn, i);
+        if(x && x->type == cJSON_String && x->valuestring) names.push_back(x->valuestring);
+    }
+    std::string toPlace = jsonDir(in, "to", "place"), toDir = jsonDir(in, "to", "dir");
+    if(toDir.empty()) toDir = "/";
+    if(toPlace.empty() || names.empty()) { cJSON_Delete(in); sendError(conn, 400, "which files, and where to?"); return; }
+    if(what == "conflicts") {
+        args.push_back("conflicts"); args.push_back(toPlace); args.push_back(toDir);
+    } else {
+        std::string op = jsonString(in, "op"), fromPlace = jsonDir(in, "from", "place"), fromDir = jsonDir(in, "from", "dir");
+        cJSON *rep = cJSON_GetObjectItem(in, "replace");
+        if(fromDir.empty()) fromDir = "/";
+        if((op != "copy" && op != "move") || fromPlace.empty()) { cJSON_Delete(in); sendError(conn, 400, "op (copy or move) and from?"); return; }
+        args.push_back("job-start"); args.push_back(op); args.push_back(fromPlace); args.push_back(fromDir);
+        args.push_back(toPlace); args.push_back(toDir); args.push_back(rep && rep->type == cJSON_True ? "replace" : "skip");
+    }
+    cJSON_Delete(in);
+    for(size_t i = 0; i < names.size(); i++) args.push_back(names[i]);
+    int rc = runTool(args, out, NULL, 0, NULL, "", NULL);
+    if(rc != 0) { sendToolError(conn, rc, out); return; }
+    cJSON *root = cJSON_CreateObject();
+    if(what == "conflicts") {
+        cJSON_AddNumberToObject(root, "freeKB", atof(lineValue(out, "freeKB").c_str()));
+        cJSON_AddBoolToObject(root, "writable", lineValue(out, "writable") == "yes");
+        cJSON_AddBoolToObject(root, "names83", lineValue(out, "names83") == "yes");
+        cJSON *ex = cJSON_CreateArray();
+        std::vector<std::string> ls = lines(out);
+        for(size_t i = 0; i < ls.size(); i++) {
+            if(ls[i].compare(0, 7, "exists=") != 0) continue;
+            std::vector<std::string> f = fields(ls[i].substr(7));
+            if(f.size() < 3) continue;
+            cJSON *o = cJSON_CreateObject();
+            cJSON_AddStringToObject(o, "name", f[0].c_str());
+            cJSON_AddStringToObject(o, "stored", f[1].c_str());
+            cJSON_AddStringToObject(o, "type", f[2] == "d" ? "folder" : f[2] == "f" ? "file" : "other");
+            cJSON_AddItemToArray(ex, o);
+        }
+        cJSON_AddItemToObject(root, "exists", ex);
+    } else {
+        cJSON_AddNumberToObject(root, "totalBytes", atof(lineValue(out, "totalBytes").c_str()));
+        cJSON_AddNumberToObject(root, "totalFiles", atof(lineValue(out, "totalFiles").c_str()));
+    }
+    sendJson(conn, root);
+}
+
 bool FilesResource::dispatch(mg_connection *conn, mg_request_info *req_info, std::string sResourceInfo)
 {
     std::string what = sResourceInfo;
@@ -413,7 +522,9 @@ bool FilesResource::dispatch(mg_connection *conn, mg_request_info *req_info, std
     else if(get && what == "zip") download(conn, qs, true);
     else if(post && what == "write") write(conn, qs);
     else if(post && (what == "mkdir" || what == "delete" || what == "rename")) change(conn, what);
-    else if(what == "places" || what == "list" || what == "read" || what == "zip" || what == "write" || what == "mkdir" || what == "delete" || what == "rename")
+    else if((get && what == "job") || (post && (what == "copy" || what == "conflicts" || what == "job/cancel"))) job(conn, what);
+    else if(what == "places" || what == "list" || what == "read" || what == "zip" || what == "write" || what == "mkdir" || what == "delete" || what == "rename"
+            || what == "copy" || what == "conflicts" || what == "job" || what == "job/cancel")
         sendError(conn, 405, "method not allowed");
     else sendError(conn, 404, "no such files call");
     return true;
diff --git a/ce_main_app/webserver/api/resource/filesresource.h b/ce_main_app/webserver/api/resource/filesresource.h
index b99320c9..6de29f24 100644
--- a/ce_main_app/webserver/api/resource/filesresource.h
+++ b/ce_main_app/webserver/api/resource/filesresource.h
@@ -26,6 +26,15 @@
 //   POST /api/v1/files/mkdir   {place, dir, name}         {name}
 //   POST /api/v1/files/delete  {place, dir, names: []}    {deleted}
 //   POST /api/v1/files/rename  {place, dir, from, to}     {name}
+//   POST /api/v1/files/conflicts {to: {place, dir}, names: []}
+//                                                 {freeKB, writable, names83, exists: [{name, stored, type}]}
+//   POST /api/v1/files/copy    {op: copy|move, from: {place, dir}, to: {place, dir}, names: [], replace}
+//                                                 starts a job in the background: {totalBytes, totalFiles}
+//   GET  /api/v1/files/job                        {state: idle|running|done|failed|cancelled, op, totalBytes,
+//                                                  doneBytes, totalFiles, doneFiles, skipped, current, message,
+//                                                  renamed: [{from, to}]}
+//   POST /api/v1/files/job/cancel
+//   GET  /api/v1/files/read?...&max=<bytes>       only the start of the file (the viewer)
 //
 // Errors: 400, 404, 409 (a name already there: {"error", "exists"}), 403
 // (read-only, or an image the ST has attached). The POSTs other than write
@@ -50,6 +59,7 @@ private:
     void download(mg_connection *conn, const char *qs, bool zip);
     void write(mg_connection *conn, const char *qs);
     void change(mg_connection *conn, const std::string &what);
+    void job(mg_connection *conn, const std::string &what);
 };
 
 #endif
