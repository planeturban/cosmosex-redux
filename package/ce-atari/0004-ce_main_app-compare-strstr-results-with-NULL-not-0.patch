diff --git a/ce_main_app/webserver/api/resource/kbdresource.cpp b/ce_main_app/webserver/api/resource/kbdresource.cpp
index b70ab290..31817039 100644
--- a/ce_main_app/webserver/api/resource/kbdresource.cpp
+++ b/ce_main_app/webserver/api/resource/kbdresource.cpp
@@ -31,13 +31,13 @@ bool KbdResource::dispatch(mg_connection *conn, mg_request_info *req_info, std::
     int len=0;
     char jsonKey[1024];
     
-    if( strstr(req_info->request_method,"GET")>0 ){
+    if( strstr(req_info->request_method,"GET") != NULL ){
         const char *qs = req_info->query_string;
         //this guarentees jsonkey to be 0-terminated
         len=mg_get_var(qs, strlen(qs == NULL ? "" : qs), "key", jsonKey, sizeof(jsonKey));
     }
      
-    if( strstr(req_info->request_method,"POST")>0 ){
+    if( strstr(req_info->request_method,"POST") != NULL ){
         //raw read, not automaticly 0-terminated
         len = mg_read(conn, jsonKey, sizeof(jsonKey)-1);
         jsonKey[len]=0; 
@@ -72,10 +72,10 @@ bool KbdResource::dispatch(mg_connection *conn, mg_request_info *req_info, std::
                 return true;
