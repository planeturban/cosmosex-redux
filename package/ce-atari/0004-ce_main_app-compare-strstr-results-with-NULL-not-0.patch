From: CosmosEx Buildroot <4372835+planeturban@users.noreply.github.com>
Date: Wed, 14 Oct 2026 22:10:03 +0200
Subject: [PATCH 4/4] ce_main_app: compare strstr() results with NULL, not > 0

The REST API resources test strstr(...) > 0, an ordered comparison of a
pointer with zero. Modern C++ compilers reject it (GCC 14: error). The
intent is "substring found", i.e. != NULL, which is what this does.
---
 ce_main_app/webserver/api/resource/configresource.cpp  | 10 +++++-----
 .../webserver/api/resource/downloadresource.cpp        |  2 +-
 ce_main_app/webserver/api/resource/floppyresource.cpp  |  6 +++---
 ce_main_app/webserver/api/resource/kbdresource.cpp     |  8 ++++----
 ce_main_app/webserver/api/resource/mouseresource.cpp   |  4 ++--
 5 files changed, 15 insertions(+), 15 deletions(-)

diff --git a/ce_main_app/webserver/api/resource/configresource.cpp b/ce_main_app/webserver/api/resource/configresource.cpp
index 4a1e6cc8..0d5198d1 100644
--- a/ce_main_app/webserver/api/resource/configresource.cpp
+++ b/ce_main_app/webserver/api/resource/configresource.cpp
@@ -77,7 +77,7 @@ bool ConfigResource::dispatch(mg_connection *conn, mg_request_info *req_info, st
     }
 
     //set loglevel
-    if( strstr(req_info->request_method,"POST")>0 && sResourceInfo=="loglevel" ){
+    if( strstr(req_info->request_method,"POST") != NULL && sResourceInfo=="loglevel" ){
         Debug::out(LOG_DEBUG, "/config/loglevel POST");
 
         char post_data[1024], loglevel[sizeof(post_data)];
@@ -116,7 +116,7 @@ bool ConfigResource::dispatch(mg_connection *conn, mg_request_info *req_info, st
     }
 
     //get configterminal screen
-    if( strstr(req_info->request_method,"GET")>0 && sResourceInfo=="terminal" ){
+    if( strstr(req_info->request_method,"GET") != NULL && sResourceInfo=="terminal" ){
         Debug::out(LOG_DEBUG, "/config/terminal GET");
         
         openFIFOsIfNeeded();
@@ -142,7 +142,7 @@ bool ConfigResource::dispatch(mg_connection *conn, mg_request_info *req_info, st
     }
 
     //return config info @TODO
-    if( strstr(req_info->request_method,"GET")>0 && sResourceInfo=="" ){
+    if( strstr(req_info->request_method,"GET") != NULL && sResourceInfo=="" ){
         Debug::out(LOG_DEBUG, "/config GET");
         //const char *qs = req_info->query_string;
         mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n");
@@ -157,7 +157,7 @@ bool ConfigResource::dispatch(mg_connection *conn, mg_request_info *req_info, st
     }
 
     //return status info
-    if( strstr(req_info->request_method,"GET")>0 && sResourceInfo=="status" ){
+    if( strstr(req_info->request_method,"GET") != NULL && sResourceInfo=="status" ){
         Debug::out(LOG_DEBUG, "/config/status GET");
         //const char *qs = req_info->query_string;
         mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n");
@@ -172,7 +172,7 @@ bool ConfigResource::dispatch(mg_connection *conn, mg_request_info *req_info, st
     }
 
     //send configterminal command
-    if( strstr(req_info->request_method,"POST")>0 && sResourceInfo=="terminal" ){
+    if( strstr(req_info->request_method,"POST") != NULL && sResourceInfo=="terminal" ){
         Debug::out(LOG_DEBUG, "/config/terminal POST");
 
         int len=0;
