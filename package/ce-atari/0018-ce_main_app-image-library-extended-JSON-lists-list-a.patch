+    std::string path, format;
+    pthread_mutex_lock(&shared.mtxImages);
+    bool ok = shared.imageList->getListFile(sourceId, path, format);
+    pthread_mutex_unlock(&shared.mtxImages);
+
+    struct stat st;
+    FILE *f = ok ? fopen(path.c_str(), "rb") : NULL;
+    if(!f || fstat(fileno(f), &st) != 0) {
+        if(f) fclose(f);
+        sendError(conn, 404, "no list for this source");
+        return;
+    }
+
+    char etag[64];
+    snprintf(etag, sizeof(etag), "\"%llx-%llx\"", (unsigned long long) st.st_size, (unsigned long long) st.st_mtime);
+    const char *inm = mg_get_header(conn, "If-None-Match");
+    if(inm && strcmp(inm, etag) == 0) {
+        fclose(f);
+        mg_printf(conn, "HTTP/1.1 304 Not Modified\r\nETag: %s\r\nCache-Control: no-cache\r\nContent-Length: 0\r\n\r\n", etag);
+        return;
+    }
+
+    mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nX-Content-Type-Options: nosniff\r\nETag: %s\r\nCache-Control: no-cache\r\nContent-Length: %llu\r\n\r\n",
+              format == "json" ? "application/json" : "text/csv; charset=iso-8859-1", etag, (unsigned long long) st.st_size);
+    char buf[16384];
+    size_t n;
+    while((n = fread(buf, 1, sizeof(buf), f)) > 0) {
+        if(mg_write(conn, buf, n) <= 0) break;
+    }
+    fclose(f);
+}
+
+#define MEDIA_MAX_SIZE      (256 * 1024)
+
+static const char *pictureType(const std::string &d)
+{
+    const unsigned char *p = (const unsigned char *) d.data();
+    size_t n = d.length();
+    if(n >= 8 && memcmp(p, "\x89PNG\r\n\x1a\n", 8) == 0) return "image/png";
+    if(n >= 3 && p[0] == 0xFF && p[1] == 0xD8 && p[2] == 0xFF) return "image/jpeg";
+    if(n >= 6 && (memcmp(p, "GIF87a", 6) == 0 || memcmp(p, "GIF89a", 6) == 0)) return "image/gif";
+    if(n >= 12 && memcmp(p, "RIFF", 4) == 0 && memcmp(p + 8, "WEBP", 4) == 0) return "image/webp";
+    return NULL;                    // never SVG or anything else
+}
+
+static size_t mediaWrite(void *ptr, size_t size, size_t nmemb, void *userdata)
+{
+    std::string *out = (std::string *) userdata;
+    size_t len = size * nmemb;
+    if(out->length() + len > MEDIA_MAX_SIZE) return 0;     // too big: abort
+    out->append((const char *) ptr, len);
+    return len;
+}
+
+void LibraryResource::onGetMedia(mg_connection *conn, const std::string &sourceId, const std::string &entryId, int n)
+{
+    bool isWeb = false;
+    std::string url, rel, root;
+
+    pthread_mutex_lock(&shared.mtxImages);
+    bool ok = shared.imageList->getMediaSrc(sourceId, entryId, n, isWeb, url, rel);
+    if(ok && !isWeb) {
+        // the source folder as it is now
+        const std::vector<ImageListSource> &sources = shared.imageList->getSources();
+        ok = false;
+        for(size_t i=0; i<sources.size(); i++) {
+            if(sources[i].src.id == sourceId) ok = ImageStorage::resolveLocation(sources[i].src.spec, root);
+        }
+    }
+    pthread_mutex_unlock(&shared.mtxImages);
+
+    if(!ok) {
+        sendError(conn, 404, "no such picture");
+        return;
+    }
+
+    std::string data;
+    if(isWeb) {
+        CURL *curl = curl_easy_init();
+        if(curl) {
+            curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+            curl_easy_setopt(curl, CURLOPT_PROTOCOLS_STR, "http,https");
+            curl_easy_setopt(curl, CURLOPT_REDIR_PROTOCOLS_STR, "http,https");
+            curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+            curl_easy_setopt(curl, CURLOPT_MAXREDIRS, 3L);
+            curl_easy_setopt(curl, CURLOPT_TIMEOUT, 5L);
+            curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+            curl_easy_setopt(curl, CURLOPT_FAILONERROR, 1L);
+            curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, mediaWrite);
+            curl_easy_setopt(curl, CURLOPT_WRITEDATA, &data);
+            if(curl_easy_perform(curl) != CURLE_OK) data.clear();
+            curl_easy_cleanup(curl);
+        }
+    } else {
+        // a file in the source folder: no "..", no symlink out of it
+        std::string full = root + "/" + rel;
+        char real[PATH_MAX], realRoot[PATH_MAX];
+        if(realpath(full.c_str(), real) && realpath(root.c_str(), realRoot) &&
+           strncmp(real, realRoot, strlen(realRoot)) == 0 && real[strlen(realRoot)] == '/') {
+            FILE *f = fopen(real, "rb");
+            if(f) {
+                char buf[16384];
+                size_t got;
+                while((got = fread(buf, 1, sizeof(buf), f)) > 0 && data.length() <= MEDIA_MAX_SIZE) data.append(buf, got);
+                fclose(f);
+                if(data.length() > MEDIA_MAX_SIZE) data.clear();
+            }
+        }
+    }
+
+    const char *type = data.empty() ? NULL : pictureType(data);
+    if(!type) {
+        sendError(conn, 404, "picture not available");
+        return;
+    }
+    mg_printf(conn, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\nX-Content-Type-Options: nosniff\r\nCache-Control: max-age=86400\r\nContent-Length: %lu\r\n\r\n",
+              type, (unsigned long) data.length());
+    mg_write(conn, data.data(), data.length());
+}
