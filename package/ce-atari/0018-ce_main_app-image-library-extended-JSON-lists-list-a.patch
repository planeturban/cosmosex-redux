+// ---------------------------------------------------------------- extended lists
+// Format: cosmosex-floppy-library.md 3a, docs/imagelist-format.md
+
+#define IMAGELIST_JSON_MAX_SIZE     (64 * 1024 * 1024)
+#define IMAGELIST_MAX_DISKS         32
+#define IMAGELIST_MAX_TEXT          256
+
+static std::string jsonStr(cJSON *o, const char *key)
+{
+    cJSON *v = o ? cJSON_GetObjectItem(o, key) : NULL;
+    if(!v || v->type != cJSON_String || !v->valuestring) return "";
+    std::string r = v->valuestring;
+    if(r.length() > 2048) r.clear();
+    return r;
+}
+
+static std::string cleanText(const std::string &in)
+{
+    std::string s = in.substr(0, IMAGELIST_MAX_TEXT);
+    for(size_t i=0; i<s.length(); i++) {
+        unsigned char c = s[i];
+        if(c == '"') s[i] = '\'';                       // as the CSV loader did
+        else if(c < 0x20 || c == '\\' || c == '/') s[i] = ' ';
+    }
+    return s;
+}
+
+static bool validId(const std::string &id)
+{
+    if(id.empty() || id.length() > 64) return false;
+    for(size_t i=0; i<id.length(); i++) {
+        char c = id[i];
+        if(!isalnum((unsigned char) c) && c != '.' && c != '_' && c != '-') return false;
+    }
+    return true;
+}
+
+// a list's file / src: relative path without "..", or (web lists only) http(s) URL
+static bool safeRef(const std::string &ref, bool web)
+{
+    if(ref.empty()) return false;
+    std::string lower = ref;
+    std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+    if(lower.compare(0, 7, "http://") == 0 || lower.compare(0, 8, "https://") == 0) return web;
+    if(lower.find(':') != std::string::npos) return false;          // other schemes, drive letters
+    if(ref[0] == '/' || ref[0] == '\\') return false;
+    std::string chk = "/" + ref + "/";
+    std::replace(chk.begin(), chk.end(), '\\', '/');
+    return chk.find("/../") == std::string::npos;
+}
+
+static void collectMedia(cJSON *arr, std::vector<std::string> &out)
+{
+    if(!arr || arr->type != cJSON_Array) return;
+    for(cJSON *m = arr->child; m; m = m->next) {
+        out.push_back(jsonStr(m, "src"));                  // "" for inline data (the browser decodes it)
+    }
+}
+
+bool ImageList::loadJsonList(int sourceIndex, std::map<std::string, bool> &seen, const char *listPath, const std::string &localRoot)
+{
+    ImageListSource &ls = sources[sourceIndex];
+    bool web = localRoot.empty();
+
+    FILE *f = fopen(listPath, "rb");
+    if(!f) return false;
+    struct stat st;
+    if(fstat(fileno(f), &st) != 0 || st.st_size > IMAGELIST_JSON_MAX_SIZE) {
+        Debug::out(LOG_ERROR, "ImageList: %s: list too big (max %d MB)", ls.src.id.c_str(), IMAGELIST_JSON_MAX_SIZE / (1024 * 1024));
+        fclose(f);
+        return false;
+    }
+    ls.updated = st.st_mtime;
+
+    char *buf = (char *) malloc(st.st_size + 1);
+    if(!buf) { fclose(f); return false; }
+    size_t got = fread(buf, 1, st.st_size, f);
+    fclose(f);
+    buf[got] = 0;
+
+    cJSON *root = cJSON_Parse(buf);
+    free(buf);
+    if(!root) {
+        Debug::out(LOG_ERROR, "ImageList: %s: the list isn't valid JSON", ls.src.id.c_str());
+        return false;
+    }
+
+    cJSON *fv = cJSON_GetObjectItem(root, "format_version");
+    if(jsonStr(root, "format") != "cosmosex-imagelist" || !fv || fv->type != cJSON_Number || fv->valueint < 1 || fv->valueint >= 2) {
+        Debug::out(LOG_ERROR, "ImageList: %s: not a cosmosex-imagelist of format version 1", ls.src.id.c_str());
+        cJSON_Delete(root);
+        return false;
+    }
+
+    ls.listFile   = listPath;
+    ls.listFormat = "json";
+    ls.version    = jsonStr(root, "list_version");
+
+    // what relative paths are relative to: base_url, else the list URL's folder
+    ls.baseUrl.clear();
+    if(web) {
+        std::string base = jsonStr(root, "base_url");
+        std::string lower = base;
+        std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+        if(lower.compare(0, 7, "http://") != 0 && lower.compare(0, 8, "https://") != 0) {
+            base = ls.src.url.substr(0, ls.src.url.rfind('/') + 1);
+        }
+        if(!base.empty() && base[base.length() - 1] != '/') base += "/";
+        ls.baseUrl = base;
+    }
+
+    cJSON *entries = cJSON_GetObjectItem(root, "entries");
+    std::map<std::string, bool> ids;
+    int skipped = 0;
+
+    for(cJSON *e = (entries && entries->type == cJSON_Array) ? entries->child : NULL; e; e = e->next) {
+        std::string id = jsonStr(e, "id");
+        std::string title = cleanText(jsonStr(e, "title"));
+        cJSON *disks = cJSON_GetObjectItem(e, "disks");
+        if(!validId(id) || ids.count(id) || title.empty() || !disks || disks->type != cJSON_Array || !disks->child) {
+            skipped++;
+            continue;
+        }
+        ids[id] = true;
+
+        // games: strings or {title}; default: the entry's title
+        std::string games;
+        std::vector<std::string> media;
+        collectMedia(cJSON_GetObjectItem(e, "media"), media);
+        cJSON *ga = cJSON_GetObjectItem(e, "games");
+        for(cJSON *g = (ga && ga->type == cJSON_Array) ? ga->child : NULL; g; g = g->next) {
+            std::string gt = (g->type == cJSON_String && g->valuestring) ? g->valuestring : jsonStr(g, "title");
+            gt = cleanText(gt);
+            std::replace(gt.begin(), gt.end(), ',', ' ');          // games are comma-separated
+            if(!gt.empty()) games += (games.empty() ? "" : ",") + gt;
+            if(g->type == cJSON_Object) collectMedia(cJSON_GetObjectItem(g, "media"), media);
+        }
+        if(games.empty()) {
+            games = title;
+            std::replace(games.begin(), games.end(), ',', ' ');
+        }
+
+        bool anyMedia = false;
+        for(size_t m=0; m<media.size(); m++) {
+            if(!media[m].empty() && !safeRef(media[m], web)) media[m].clear();      // unsafe src: not served
+            if(!media[m].empty()) anyMedia = true;
+        }
+        if(anyMedia) mediaSrc[ls.src.id + "/" + id] = media;
+
+        // one item per disk
+        int count = 0;
+        for(cJSON *d = disks->child; d; d = d->next) count++;
+        if(count > IMAGELIST_MAX_DISKS) count = IMAGELIST_MAX_DISKS;
+
+        int index = 0;
+        for(cJSON *d = disks->child; d && index < count; d = d->next) {
+            index++;
+            std::string file = jsonStr(d, "file");
+            if(!safeRef(file, web)) {
+                Debug::out(LOG_DEBUG, "ImageList: %s: entry %s: disk file '%s' refused", ls.src.id.c_str(), id.c_str(), file.c_str());
+                continue;
+            }
+
+            ImageListItem li;
+            li.available    = true;
+            li.marked       = false;
+            li.sourceIndex  = sourceIndex;
+            li.entryId      = id;
+            li.title        = title;
+            li.diskIndex    = index;
+            li.diskCount    = count;
+            li.diskLabel    = cleanText(jsonStr(d, "label"));
+            li.gamesDisplay = games;
+            li.games        = games + "," + title;              // the title is searchable too
+            std::transform(li.games.begin(), li.games.end(), li.games.begin(), ::tolower);
+
+            int checksum = 0;
+            sscanf(jsonStr(d, "checksum").c_str(), "0x%x", &checksum);
+            li.checksum = checksum;
+
+            std::string dir, name;
+            Utils::splitFilenameFromPath(file, dir, name);
+            li.imageName = name;
+
+            std::string lower = file;
+            std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+            bool absolute = lower.compare(0, 7, "http://") == 0 || lower.compare(0, 8, "https://") == 0;
+            if(web) {
+                li.url = absolute ? file : ls.baseUrl + file;
+            } else {
+                li.localPath = localRoot + "/" + file;
+            }
+            addItem(li, seen);
+        }
+    }
+
+    cJSON_Delete(root);
+    if(skipped) {
+        Debug::out(LOG_ERROR, "ImageList: %s: %d entries skipped (missing or duplicate id, no title or no disks)", ls.src.id.c_str(), skipped);
+    }
+    Debug::out(LOG_DEBUG, "ImageList: %s: %d images from a JSON list (version %s)", ls.src.id.c_str(), ls.entries, ls.version.c_str());
+    return true;
+}
+
+bool ImageList::getMediaSrc(const std::string &sourceId, const std::string &entryId, int n, bool &isWeb, std::string &url, std::string &relPath)
+{
+    url.clear();
+    relPath.clear();
+    std::map<std::string, std::vector<std::string> >::iterator it = mediaSrc.find(sourceId + "/" + entryId);
+    if(it == mediaSrc.end() || n < 0 || n >= (int) it->second.size() || it->second[n].empty()) return false;
+
+    for(size_t i=0; i<sources.size(); i++) {
+        if(sources[i].src.id != sourceId) continue;
+        const std::string &src = it->second[n];
+        isWeb = sources[i].src.type == IMAGELIB_TYPE_WEB;
+        if(isWeb) {
+            std::string lower = src;
+            std::transform(lower.begin(), lower.end(), lower.begin(), ::tolower);
+            bool absolute = lower.compare(0, 7, "http://") == 0 || lower.compare(0, 8, "https://") == 0;
+            url = absolute ? src : sources[i].baseUrl + src;
+        } else {
+            if(!safeRef(src, false)) return false;
+            relPath = src;
+        }
+        return true;
+    }
+    return false;
+}
+
+bool ImageList::getListFile(const std::string &sourceId, std::string &path, std::string &format)
+{
+    for(size_t i=0; i<sources.size(); i++) {
+        if(sources[i].src.id == sourceId && sources[i].src.enabled && !sources[i].listFile.empty()) {
+            path   = sources[i].listFile;
+            format = sources[i].listFormat;
+            return true;
+        }
+    }
+    return false;
+}
