From 54fa7151abb442970482e2d2f0cd9b5c65be6153 Mon Sep 17 00:00:00 2001
From: CosmosEx Buildroot <4372835+planeturban@users.noreply.github.com>
Date: Sun, 15 Nov 2026 12:20:26 +0100
Subject: [PATCH] ce_main_app: downloaded floppy images: file mode from the
 umask

copyFileSafely() created files with mode 0644 whatever the umask, so
images downloaded into /pi (shared over NFS/SMB as the user pi) couldn't
be replaced or deleted from another computer. Create them with 0666 and
let the umask decide (the Buildroot image runs the app with 002).
---
 ce_main_app/floppy/unpackcache.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/ce_main_app/floppy/unpackcache.cpp b/ce_main_app/floppy/unpackcache.cpp
index 96119401..a0f75e32 100644
--- a/ce_main_app/floppy/unpackcache.cpp
+++ b/ce_main_app/floppy/unpackcache.cpp
@@ -119,7 +119,7 @@ bool UnpackCache::copyFileSafely(const std::string &src, const std::string &dst)
     std::string tmp = dst + ".tmp";
     int in = open(src.c_str(), O_RDONLY);
     if(in < 0) return false;
-    int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0666);     // the umask decides (the image runs the app with 002: group-writable on /pi)
     if(out < 0) { close(in); return false; }
 
     bool ok = true;
-- 
