+// POST /api/v1/settings/hddimage/inspectwrite?op=put&path=&part=&dir=&name=[&overwrite=1]
+//      body: the file (application/octet-stream, at most HDINSPECT_PUT_MAX_MB)
+// POST ...?op=mkdir&path=&part=&dir=&name=       a folder
+// POST ...?op=rm&path=&part=&file=                a file or a folder (with what's in it)
+// Only images the ST has on no ID (ce-hdinspect checks); FAT names become 8.3.
+#define HDINSPECT_PUT_MAX_MB    64
+
+void SettingsResource::inspectWrite(mg_connection *conn, mg_request_info *req_info)
+{
+    const char *qs = req_info->query_string ? req_info->query_string : "";
+    char path[PATH_MAX], part[8] = "", op[16] = "", dir[PATH_MAX] = "", name[256] = "", file[PATH_MAX] = "", over[8] = "";
+    std::string real, kind;
+    mg_get_var(qs, strlen(qs), "op", op, sizeof(op));
+    bool put = strcmp(op, "put") == 0;
+    long long total = 0;
+    if(put) {
+        const char *ctype = mg_get_header(conn, "Content-Type");
+        if(!ctype || strncasecmp(ctype, "application/octet-stream", 24) != 0) { sendError(conn, 415, "Content-Type must be application/octet-stream"); return; }
+        const char *len = mg_get_header(conn, "Content-Length");
+        total = len ? atoll(len) : -1;
+        if(total < 0) { sendError(conn, 411, "Content-Length needed"); return; }
+        if(total > (long long) HDINSPECT_PUT_MAX_MB * 1024 * 1024) {
+            char b[160];
+            snprintf(b, sizeof(b), "That's too large to upload into an image here (at most %d MB): copy it to a translated drive instead.", HDINSPECT_PUT_MAX_MB);
+            sendError(conn, 413, b);
+            return;
+        }
+    }
+    if(mg_get_var(qs, strlen(qs), "path", path, sizeof(path)) <= 0 || !listedImage(path, real, kind)) { sendError(conn, 404, "no such image"); return; }
+    mg_get_var(qs, strlen(qs), "part", part, sizeof(part));
+    mg_get_var(qs, strlen(qs), "dir", dir, sizeof(dir));
+    mg_get_var(qs, strlen(qs), "name", name, sizeof(name));
+    mg_get_var(qs, strlen(qs), "file", file, sizeof(file));
+    mg_get_var(qs, strlen(qs), "overwrite", over, sizeof(over));
+    if(!part[0]) { sendError(conn, 400, "which partition?"); return; }
+    for(const char *c = part; *c; c++) if(*c < '0' || *c > '9') { sendError(conn, 400, "bad partition"); return; }
+
+    std::vector<std::string> args;
+    args.push_back(HDINSPECT_TOOL);
+    char size[32];
+    snprintf(size, sizeof(size), "%lld", total);
+    if(put || strcmp(op, "mkdir") == 0) {
+        if(!name[0]) { sendError(conn, 400, "which name?"); return; }
+        args.push_back(op); args.push_back(real); args.push_back(part); args.push_back(dir[0] ? dir : "/"); args.push_back(name);
+        if(put) { args.push_back(size); if(over[0] == '1') args.push_back("overwrite"); }
+    } else if(strcmp(op, "rm") == 0) {
+        if(!file[0]) { sendError(conn, 400, "which file?"); return; }
+        args.push_back("rm"); args.push_back(real); args.push_back(part); args.push_back(file);
+    } else {
+        sendError(conn, 400, "op: put, mkdir or rm");
+        return;
+    }
+
+    std::string out;
+    int rc = runArgv(args, &out, 1 << 16, NULL, put ? conn : NULL, total);
+    std::string err = lineValue(out, "error"), exists = lineValue(out, "exists");
+    if(rc != 0) {
+        if(!exists.empty()) {
+            cJSON *e = cJSON_CreateObject();
+            cJSON_AddStringToObject(e, "error", err.c_str());
+            cJSON_AddStringToObject(e, "exists", exists.c_str());
+            sendJson(conn, e, 409);
+        } else {
+            sendError(conn, 400, err.empty() ? "can't change the image" : err.c_str());
+        }
+        return;
+    }
+    Debug::out(LOG_INFO, "SettingsResource: %s in %s (partition %s): %s", op, real.c_str(), part, put || op[0] == 'm' ? name : file);
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddBoolToObject(root, "ok", true);
+    std::string n = lineValue(out, "name"), d = lineValue(out, "deleted");
+    if(!n.empty()) cJSON_AddStringToObject(root, "name", n.c_str());
+    if(!d.empty()) cJSON_AddStringToObject(root, "deleted", d.c_str());
+    if(put) cJSON_AddNumberToObject(root, "size", (double) total);
+    sendJson(conn, root);
+}
+
