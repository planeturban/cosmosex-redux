@@ -1147,25 +1157,50 @@ void SettingsResource::sendError(mg_connection *conn, int code, const char *mess
 // run a program without a shell (arguments from requests can't become
 // commands); its stdout into out (at most maxOut bytes), or as a chunked
 // response to conn. Returns the exit status (-1: couldn't run).
-static int runArgv(const std::vector<std::string> &args, std::string *out, size_t maxOut, mg_connection *stream)
+// bodyFrom: the request body (bodyLen bytes) goes to the program's stdin
+// (all of it is read from the connection, also when the program stops early)
+static int runArgv(const std::vector<std::string> &args, std::string *out, size_t maxOut, mg_connection *stream,
+                   mg_connection *bodyFrom = NULL, long long bodyLen = 0)
 {
     std::vector<char *> argv;                   // made before fork: the child mustn't allocate (other threads)
     for(size_t i = 0; i < args.size(); i++) argv.push_back((char *) args[i].c_str());
     argv.push_back(NULL);
-    int fds[2];
+    int fds[2], ins[2] = { -1, -1 };
     if(pipe(fds) != 0) return -1;
+    if(bodyFrom && pipe(ins) != 0) { close(fds[0]); close(fds[1]); return -1; }
     pid_t pid = fork();
-    if(pid < 0) { close(fds[0]); close(fds[1]); return -1; }
+    if(pid < 0) { close(fds[0]); close(fds[1]); if(ins[0] >= 0) { close(ins[0]); close(ins[1]); } return -1; }
     if(pid == 0) {
         dup2(fds[1], 1);
         int nul = open("/dev/null", O_RDWR);
-        if(nul >= 0) { dup2(nul, 0); dup2(nul, 2); }
+        if(nul >= 0) { dup2(ins[0] >= 0 ? ins[0] : nul, 0); dup2(nul, 2); }
         long maxFd = sysconf(_SC_OPEN_MAX);
         for(long fd = 3; fd < (maxFd > 0 ? maxFd : 1024); fd++) close(fd);
         execv(argv[0], &argv[0]);
         _exit(127);
     }
     close(fds[1]);
+    if(bodyFrom) {
+        // the program says little until it has read everything (its output
+        // fits the pipe), so writing all of the body first can't deadlock
+        close(ins[0]);
+        std::vector<char> inv(65536);                    // per request: requests run in parallel
+        char *inBuf = &inv[0];
+        long long got = 0;
+        bool feeding = true;
+        while(got < bodyLen) {
+            int r = mg_read(bodyFrom, inBuf, (size_t) std::min<long long>((long long) inv.size(), bodyLen - got));
+            if(r <= 0) break;
+            got += r;
+            for(int w = 0; feeding && w < r; ) {
+                ssize_t n = write(ins[1], inBuf + w, r - w);
+                if(n < 0 && errno == EINTR) continue;
+                if(n <= 0) { feeding = false; break; }       // it stopped reading (EPIPE: SIGPIPE is ignored)
+                w += n;
+            }
+        }
+        close(ins[1]);
+    }
     std::vector<char> buf(65536);
     ssize_t n;
     bool ok = true;
@@ -1310,6 +1345,83 @@ void SettingsResource::inspectImage(mg_connection *conn, mg_request_info *req_in
     sendJson(conn, root);
