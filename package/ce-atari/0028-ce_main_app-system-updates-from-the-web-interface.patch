+#ifndef SYSTEMRESOURCE_H
+#define SYSTEMRESOURCE_H
+
+#include <string>
+
+#include "../../CivetServer.h"
+
+#include "iapiresource.h"
+
+// System updates for the web interface, done by the image's SYSUPDATE_TOOL
+// (Buildroot image: /usr/sbin/ce-sysupdate, A/B root partitions; see there).
+//
+//   GET  /api/v1/system/update            state: version, slot, progress, newest published ...
+//   POST /api/v1/system/update/check      look for the newest published image (waits for it)
+//   POST /api/v1/system/update/online     download and install it (runs on; poll GET)
+//   POST /api/v1/system/update/upload     the body is an SD card image (.img or .img.xz),
+//                                         Content-Type application/octet-stream,
+//                                         X-File-Name: its name; installed like online
+//   POST /api/v1/system/update/keep       while trying a new system: keep it
+//   POST /api/v1/system/update/back       ... or restart into the old one
+//   POST /api/v1/system/update/previous   restart into the system installed before
+//
+// The POSTs other than upload need Content-Type application/json (a page on
+// another site can't send that without asking first). Without the tool every
+// request answers "available": false.
+
+#define SYSUPDATE_TOOL      "/usr/sbin/ce-sysupdate"
+#define SYSUPDATE_MAX_MB    2048            // largest upload
+
+class SystemResource : public IApiResource {
+public:
+    SystemResource();
+    virtual ~SystemResource();
+    bool dispatch(mg_connection *conn, mg_request_info *req_info, std::string sResourceInfo="" );
+
+private:
+    void sendJson(mg_connection *conn, struct cJSON *root, int code = 200);
+    void sendError(mg_connection *conn, int code, const std::string &message);
+    void sendStatus(mg_connection *conn);
+    void upload(mg_connection *conn);
+};
+
+#endif
