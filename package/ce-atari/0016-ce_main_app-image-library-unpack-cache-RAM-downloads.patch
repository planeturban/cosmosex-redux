+        // Floppy images are downloaded (and unzipped) in RAM first, then copied
+        // to the storage (USB stick, share) as <name>.tmp, synced and renamed:
+        // a stick pulled out or a share gone mid-download leaves no half file
+        bool floppyViaRam = (downloadCurrent.downloadType == DWNTYPE_FLOPPYIMG);
+        if(floppyViaRam) {
+            mkdir(DOWNLOAD_RAM_DIR, 0755);
+            tmpFile = std::string(DOWNLOAD_RAM_DIR "/") + fileName + "_dwnldng";
+        }
+
         outfile = fopen(tmpFile.c_str(), "wb");    // try to open the tmp file
 
         if(!outfile) {
@@ -567,7 +624,10 @@ void Downloader::run(void)
 
             bool b = Downloader::verifyChecksum(tmpFile.c_str(), downloadCurrent.checksum);
 
-            if(b) {             // checksum is OK?
+            if(b && floppyViaRam) {     // checksum is OK, floppy image: unzip in RAM, then put it in place
+                bool ok = finishFloppyDownload(tmpFile, finalFile);
+                updateStatusByte(downloadCurrent, ok ? DWNSTATUS_DOWNLOAD_OK : DWNSTATUS_DOWNLOAD_FAIL);
+            } else if(b) {             // checksum is OK?
                 bool isZIPfile = Utils::isZIPfile(finalFile.c_str());
 
                 Debug::out(LOG_ERROR, "Downloader - finalFile: %s, isZIPfile: %d", finalFile.c_str(), isZIPfile);
