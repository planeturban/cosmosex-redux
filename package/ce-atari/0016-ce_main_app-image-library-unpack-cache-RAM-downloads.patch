+// A downloaded floppy image (in RAM, tmpFile): if it's a zip, unpack it and
+// keep its first image (named like the zip, with the image's extension, as
+// before). Copy it to its place in the storage (finalFile's folder) as
+// <name>.tmp, sync, rename. The RAM copies are removed in any case.
+bool Downloader::finishFloppyDownload(const std::string &tmpFile, const std::string &finalFile)
+{
+    std::string src = tmpFile;
+    std::string dst = finalFile;
+    std::string unzDir = std::string(DOWNLOAD_RAM_DIR "/unpack");
+    bool ok = true;
+
+    if(Utils::isZIPfile(finalFile.c_str())) {
+        UnpackCache::removeTree(unzDir);
+        mkdir(unzDir.c_str(), 0755);
+        std::string image;
+        if(!UnpackCache::runUnzip(tmpFile, unzDir) || !UnpackCache::findFirstImage(unzDir, image)) {
+            Debug::out(LOG_ERROR, "Downloader - no .st / .msa image in the downloaded zip %s", finalFile.c_str());
+            ok = false;
+        } else {
+            const char *ext = Utils::getExtension(image.c_str());
+            std::string extLower = ext ? ext : "st";
+            std::transform(extLower.begin(), extLower.end(), extLower.begin(), ::tolower);
+            std::string zipName = finalFile;
+            Utils::createPathWithOtherExtension(zipName, extLower.c_str(), dst);
+            src = image;
+        }
+    }
+
+    if(ok) {
+        if(dst.compare(0, strlen(DOWNLOAD_RAM_DIR), DOWNLOAD_RAM_DIR) == 0 || dst.compare(0, 5, "/tmp/") == 0) {
+            ok = rename(src.c_str(), dst.c_str()) == 0;             // storage is in RAM too (no USB stick or share)
+        } else {
+            ok = UnpackCache::copyFileSafely(src, dst);
+        }
+        if(!ok) {
+            Debug::out(LOG_ERROR, "Downloader - failed to store %s: %s", dst.c_str(), strerror(errno));
+        } else {
+            Debug::out(LOG_DEBUG, "Downloader - stored %s", dst.c_str());
+        }
+    }
+
+    unlink(tmpFile.c_str());
+    UnpackCache::removeTree(unzDir);
+    return ok;
+}
+
 // ZIPed floppy file image needs some extracting, searching and renaming of content
