@@ -0,0 +1,38 @@
+#ifndef _ZIPUTIL_H_
+#define _ZIPUTIL_H_
+
+// Helpers for the floppy unpack cache (unpackcache.cpp) that don't depend on
+// the rest of the app (unit-tested on the build host).
+
+#include <string>
+#include <vector>
+#include <stdint.h>
+#include <time.h>
+
+class ZipUtil
+{
+public:
+    // Total unpacked size of all files in a zip, from its central directory
+    // (no unpacking). -1: not a zip, damaged, or zip64 (size unknown).
+    // entries (if given): number of files.
+    static int64_t unpackedSize(const char *zipPath, int *entries = NULL);
+};
+
+// One unpacked image in the cache
+typedef struct {
+    std::string name;       // directory name in the cache
+    int64_t     size;       // bytes used
+    time_t      lastUsed;   // last insert (directory mtime)
+    bool        inSlot;     // an inserted image comes from it: never evicted
+} UnpackCacheEntry;
+
+class UnpackCachePolicy
+{
+public:
+    // Which entries to delete so that 'need' bytes fit: oldest first, never
+    // one that is in a slot. Returns false (and nothing to delete) if even
+    // deleting all allowed entries doesn't make room.
+    static bool pickEvictions(const std::vector<UnpackCacheEntry> &entries, int64_t freeBytes, int64_t need, std::vector<std::string> &evict);
+};
+
+#endif
