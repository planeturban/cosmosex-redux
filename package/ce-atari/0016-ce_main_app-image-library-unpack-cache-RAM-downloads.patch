diff --git a/ce_main_app/floppy/unpackcache.cpp b/ce_main_app/floppy/unpackcache.cpp
new file mode 100644
index 00000000..96119401
--- /dev/null
+++ b/ce_main_app/floppy/unpackcache.cpp
@@ -0,0 +1,317 @@
+#include <stdio.h>
+#include <string.h>
+#include <stdlib.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/statvfs.h>
+#include <sys/time.h>
+#include <sys/wait.h>
+#include <strings.h>
+#include <algorithm>
+
+#include "unpackcache.h"
+#include "ziputil.h"
+#include "imagelibsources.h"
+#include "../debug.h"
+
+std::string UnpackCache::lastErr;
+
+// tmpfs rounds every file up to a page; leave a little room for that
+#define UNPACK_MARGIN   (64 * 1024)
+
+static bool isDir(const std::string &p)
+{
+    struct stat st;
+    return stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static int64_t treeSize(const std::string &path)
+{
+    struct stat st;
+    if(lstat(path.c_str(), &st) != 0) return 0;
+    if(!S_ISDIR(st.st_mode)) return (int64_t) st.st_blocks * 512;
+
+    int64_t total = 0;
+    DIR *d = opendir(path.c_str());
+    if(!d) return 0;
+    struct dirent *de;
+    while((de = readdir(d)) != NULL) {
+        if(strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+        total += treeSize(path + "/" + de->d_name);
+    }
+    closedir(d);
+    return total;
+}
+
+bool UnpackCache::removeTree(const std::string &path)
+{
+    struct stat st;
+    if(lstat(path.c_str(), &st) != 0) return errno == ENOENT;
+    if(!S_ISDIR(st.st_mode)) return unlink(path.c_str()) == 0;
+
+    DIR *d = opendir(path.c_str());
+    if(d) {
+        struct dirent *de;
+        while((de = readdir(d)) != NULL) {
+            if(strcmp(de->d_name, ".") == 0 || strcmp(de->d_name, "..") == 0) continue;
+            removeTree(path + "/" + de->d_name);
+        }
+        closedir(d);
+    }
+    return rmdir(path.c_str()) == 0;
+}
+
+bool UnpackCache::runUnzip(const std::string &zipPath, const std::string &destDir)
+{
+    pid_t pid = fork();
+    if(pid < 0) return false;
+
+    if(pid == 0) {                                  // child: quiet, no shell (names may contain quotes)
+        int nul = open("/dev/null", O_RDWR);
+        if(nul >= 0) { dup2(nul, 1); dup2(nul, 2); }
+        execlp("unzip", "unzip", "-o", "-q", zipPath.c_str(), "-d", destDir.c_str(), (char *) NULL);
+        _exit(127);
+    }
+
+    int status = 0;
+    while(waitpid(pid, &status, 0) < 0 && errno == EINTR) { }
+    return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
+
+static bool hasImageExt(const char *name)
+{
+    const char *ext = strrchr(name, '.');
+    return ext && (strcasecmp(ext, ".st") == 0 || strcasecmp(ext, ".msa") == 0) && strlen(name) >= 4;
+}
+
+bool UnpackCache::findFirstImage(const std::string &dir, std::string &imagePath, int depth)
+{
+    std::vector<std::string> files, dirs;
+    DIR *d = opendir(dir.c_str());
+    if(!d) return false;
+    struct dirent *de;
+    while((de = readdir(d)) != NULL) {
+        if(de->d_name[0] == '.') continue;          // ., .., our marker, __MACOSX-style hidden files
+        std::string p = dir + "/" + de->d_name;
+        struct stat st;
+        if(lstat(p.c_str(), &st) != 0) continue;
+        if(S_ISREG(st.st_mode) && hasImageExt(de->d_name)) files.push_back(p);
+        else if(S_ISDIR(st.st_mode) && strcmp(de->d_name, "__MACOSX") != 0) dirs.push_back(p);
+    }
+    closedir(d);
+
+    std::sort(files.begin(), files.end());          // stable choice: first by name
+    std::sort(dirs.begin(), dirs.end());
+    if(!files.empty()) { imagePath = files[0]; return true; }
+    if(depth >= 2) return false;
+    for(size_t i = 0; i < dirs.size(); i++) {
+        if(findFirstImage(dirs[i], imagePath, depth + 1)) return true;
+    }
+    return false;
+}
+
+bool UnpackCache::copyFileSafely(const std::string &src, const std::string &dst)
+{
+    std::string tmp = dst + ".tmp";
+    int in = open(src.c_str(), O_RDONLY);
+    if(in < 0) return false;
+    int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if(out < 0) { close(in); return false; }
+
+    bool ok = true;
+    char buf[65536];
+    ssize_t n;
+    while((n = read(in, buf, sizeof(buf))) > 0) {
+        ssize_t off = 0;
+        while(off < n) {
+            ssize_t w = write(out, buf + off, n - off);
+            if(w <= 0) { ok = false; break; }
+            off += w;
+        }
+        if(!ok) break;
+    }
+    if(n < 0) ok = false;
+    if(fsync(out) != 0) ok = false;
+    if(close(out) != 0) ok = false;
+    close(in);
+
+    if(ok && rename(tmp.c_str(), dst.c_str()) != 0) ok = false;
+    if(!ok) unlink(tmp.c_str());
+    return ok;
+}
+
+// On the first use after app start: remove half-done unpacks
+void UnpackCache::cleanupOnce(void)
+{
+    static bool done = false;
+    if(done) return;
+    done = true;
+
+    mkdir(UNPACK_CACHE_DIR, 0755);
+    DIR *d = opendir(UNPACK_CACHE_DIR);
+    if(!d) return;
+    struct dirent *de;
+    std::vector<std::string> remove;
+    while((de = readdir(d)) != NULL) {
+        if(de->d_name[0] == '.') continue;
+        std::string p = std::string(UNPACK_CACHE_DIR "/") + de->d_name;
+        struct stat st;
+        if(!isDir(p) || stat((p + "/" UNPACK_DONE_MARKER).c_str(), &st) != 0) remove.push_back(p);
+    }
+    closedir(d);
+    for(size_t i = 0; i < remove.size(); i++) {
+        Debug::out(LOG_DEBUG, "UnpackCache: removing unfinished %s", remove[i].c_str());
+        removeTree(remove[i]);
+    }
+}
+
+std::string UnpackCache::lastError(void)
+{
+    return lastErr;
+}
+
+static bool readMarker(const std::string &dir, std::string &image)
+{
+    FILE *f = fopen((dir + "/" UNPACK_DONE_MARKER).c_str(), "r");
+    if(!f) return false;
+    char line[1024];
+    bool ok = fgets(line, sizeof(line), f) != NULL;
+    fclose(f);
+    if(!ok) return false;
+    line[strcspn(line, "\r\n")] = 0;
+    if(!line[0] || strstr(line, "..") || line[0] == '/') return false;
+    image = dir + "/" + line;
+    struct stat st;
+    return stat(image.c_str(), &st) == 0 && S_ISREG(st.st_mode);
+}
+
+bool UnpackCache::getImage(const std::string &zipPath, const std::vector<std::string> &inUse, std::string &imagePath, std::string &error)
+{
+    cleanupOnce();
+    error.clear();
+
+    struct stat zst;
+    if(stat(zipPath.c_str(), &zst) != 0) {
+        error = "zip file not found";
+        lastErr = error;
+        return false;
+    }
+
+    // The folder name changes when the zip does (size, time), so a changed
+    // zip is unpacked again; the old folder ages out
+    char key[96];
+    snprintf(key, sizeof(key), "%s%s-%lld-%lld", "", ImageLibSources::shortHash(zipPath).c_str(), (long long) zst.st_size, (long long) zst.st_mtime);
+    std::string dir = std::string(UNPACK_CACHE_DIR "/") + key;
+
+    if(isDir(dir) && readMarker(dir, imagePath)) {
+        utimes(dir.c_str(), NULL);                  // used now (least recently inserted goes first)
+        Debug::out(LOG_DEBUG, "UnpackCache: %s already unpacked: %s", zipPath.c_str(), imagePath.c_str());
+        lastErr.clear();
+        return true;
+    }
+    removeTree(dir);
+
+    int entries = 0;
+    int64_t need = ZipUtil::unpackedSize(zipPath.c_str(), &entries);
+    if(need < 0) {
+        Debug::out(LOG_DEBUG, "UnpackCache: can't read the size from %s, unpacking anyway", zipPath.c_str());
+        need = 0;
+    }
+    need += UNPACK_MARGIN + (int64_t) entries * 4096;  // per-file rounding up to a page
+
+    struct statvfs vfs;
+    if(statvfs(UNPACK_CACHE_DIR, &vfs) != 0) {
+        error = "unpack RAM disk not available";
+        lastErr = error;
+        return false;
+    }
+    int64_t total = (int64_t) vfs.f_blocks * vfs.f_frsize;
+    int64_t freeB = (int64_t) vfs.f_bavail * vfs.f_frsize;
+
+    if(need > total) {
+        error = "the zip unpacks to more than the unpack RAM disk holds";
+        Debug::out(LOG_ERROR, "UnpackCache: %s needs %lld bytes, the RAM disk has %lld", zipPath.c_str(), (long long) need, (long long) total);
+        lastErr = error;
+        return false;
+    }
+
+    if(need > freeB) {
+        // what's in the cache, and which of it is in a slot
+        std::vector<UnpackCacheEntry> entriesNow;
+        DIR *d = opendir(UNPACK_CACHE_DIR);
+        if(d) {
+            struct dirent *de;
+            while((de = readdir(d)) != NULL) {
+                if(de->d_name[0] == '.') continue;
+                std::string p = std::string(UNPACK_CACHE_DIR "/") + de->d_name;
+                struct stat st;
+                if(stat(p.c_str(), &st) != 0 || !S_ISDIR(st.st_mode)) continue;
+                UnpackCacheEntry e;
+                e.name     = de->d_name;
+                e.size     = treeSize(p);
+                e.lastUsed = st.st_mtime;
+                e.inSlot   = false;
+                for(size_t i = 0; i < inUse.size(); i++) {
+                    if(inUse[i].compare(0, p.length() + 1, p + "/") == 0) e.inSlot = true;
+                }
+                entriesNow.push_back(e);
+            }
+            closedir(d);
+        }
+
+        std::vector<std::string> evict;
+        if(!UnpackCachePolicy::pickEvictions(entriesNow, freeB, need, evict)) {
+            error = "no room in the unpack RAM disk (the inserted disks use it)";
+            Debug::out(LOG_ERROR, "UnpackCache: %s: %s", zipPath.c_str(), error.c_str());
+            lastErr = error;
+            return false;
+        }
+        for(size_t i = 0; i < evict.size(); i++) {
+            Debug::out(LOG_INFO, "UnpackCache: evicting %s (least recently inserted)", evict[i].c_str());
+            removeTree(std::string(UNPACK_CACHE_DIR "/") + evict[i]);
+        }
+    }
+
+    std::string part = dir + ".part";
+    removeTree(part);
+    if(mkdir(part.c_str(), 0755) != 0) {
+        error = "can't create the unpack folder";
+        lastErr = error;
+        return false;
+    }
+
+    bool ok = runUnzip(zipPath, part);
+    std::string found;
+    if(ok) ok = findFirstImage(part, found);
+
+    if(!ok) {
+        statvfs(UNPACK_CACHE_DIR, &vfs);
+        bool full = (int64_t) vfs.f_bavail * vfs.f_frsize < UNPACK_MARGIN;
+        error = full ? "the unpack RAM disk filled up while unpacking" : "no .st or .msa image in the zip (or a damaged zip)";
+        Debug::out(LOG_ERROR, "UnpackCache: %s: %s", zipPath.c_str(), error.c_str());
+        removeTree(part);
+        lastErr = error;
+        return false;
+    }
+
+    // marker: the image's path inside the folder
+    std::string rel = found.substr(part.length() + 1);
+    FILE *f = fopen((part + "/" UNPACK_DONE_MARKER).c_str(), "w");
+    bool markerOk = f && fprintf(f, "%s\n", rel.c_str()) > 0;
+    if(f && fclose(f) != 0) markerOk = false;
+    if(!markerOk || rename(part.c_str(), dir.c_str()) != 0) {
+        error = "the unpack RAM disk filled up while unpacking";
+        removeTree(part);
+        lastErr = error;
+        return false;
+    }
+
+    imagePath = dir + "/" + rel;
+    Debug::out(LOG_DEBUG, "UnpackCache: unpacked %s -> %s", zipPath.c_str(), imagePath.c_str());
+    lastErr.clear();
+    return true;
+}
diff --git a/ce_main_app/floppy/unpackcache.h b/ce_main_app/floppy/unpackcache.h
new file mode 100644
index 00000000..436d09f8
--- /dev/null
+++ b/ce_main_app/floppy/unpackcache.h
@@ -0,0 +1,47 @@
+#ifndef _UNPACKCACHE_H_
+#define _UNPACKCACHE_H_
+
+// Zipped floppy images are unpacked on insert into a small RAM disk (a 16 MB
+// tmpfs at UNPACK_CACHE_DIR, mounted by the image; created as a plain folder
+// otherwise). One folder per zip (named from its path, size and time), kept
+// after eject: inserting the same zip again reuses it. When space runs out,
+// the least recently inserted folders are deleted first; a folder an
+// inserted image comes from is never deleted (its saves go there).
+//
+// Replaces the single /tmp/zipedfloppy folder, which was emptied on every
+// zip insert, so the saves of a zipped disk in one slot were lost when a zip
+// went into another slot.
+//
+// Used only from the floppy encoder thread (which opens all images).
+
+#include <string>
+#include <vector>
+
+#ifndef UNPACK_CACHE_DIR
+#define UNPACK_CACHE_DIR    "/run/ce-floppy"
+#endif
+#define UNPACK_DONE_MARKER  ".ce-unpacked"
+
+class UnpackCache
+{
+public:
+    // Unpacks zipPath (or reuses an earlier unpack) and returns the first
+    // floppy image in it. inUse: image files open in the slots now (their
+    // folders are kept). False with a reason in error.
+    static bool getImage(const std::string &zipPath, const std::vector<std::string> &inUse, std::string &imagePath, std::string &error);
+
+    // Last problem, for the web UI ("" if the last insert worked)
+    static std::string lastError(void);
+
+    // Helpers (also used by the downloader)
+    static bool runUnzip(const std::string &zipPath, const std::string &destDir);      // busybox/info-zip unzip, no shell
+    static bool removeTree(const std::string &path);
+    static bool findFirstImage(const std::string &dir, std::string &imagePath, int depth = 0);     // first .st / .msa (top level first)
+    static bool copyFileSafely(const std::string &src, const std::string &dst);        // dst.tmp, fsync, rename
+
+private:
+    static void cleanupOnce(void);
+    static std::string lastErr;
+};
+
+#endif
diff --git a/ce_main_app/floppy/ziputil.cpp b/ce_main_app/floppy/ziputil.cpp
new file mode 100644
index 00000000..5196a42d
--- /dev/null
+++ b/ce_main_app/floppy/ziputil.cpp
@@ -0,0 +1,86 @@
+#include <stdio.h>
+#include <string.h>
+#include <algorithm>
+
+#include "ziputil.h"
+
+static uint32_t rd16(const unsigned char *p) { return p[0] | (p[1] << 8); }
+static uint32_t rd32(const unsigned char *p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((uint32_t) p[3] << 24); }
+
+int64_t ZipUtil::unpackedSize(const char *zipPath, int *entries)
+{
+    if(entries) *entries = 0;
+
+    FILE *f = fopen(zipPath, "rb");
+    if(!f) return -1;
+
+    // End of central directory record: 22 bytes + up to 64 KB comment, at the end
+    if(fseek(f, 0, SEEK_END) != 0) { fclose(f); return -1; }
+    long fileSize = ftell(f);
+    if(fileSize < 22) { fclose(f); return -1; }
+
+    long tailLen = fileSize < (22 + 65535) ? fileSize : (22 + 65535);
+    std::vector<unsigned char> tail(tailLen);
+    if(fseek(f, fileSize - tailLen, SEEK_SET) != 0 || fread(&tail[0], 1, tailLen, f) != (size_t) tailLen) { fclose(f); return -1; }
+
+    long eocd = -1;
+    for(long i = tailLen - 22; i >= 0; i--) {
+        if(rd32(&tail[i]) == 0x06054b50) { eocd = i; break; }
+    }
+    if(eocd < 0) { fclose(f); return -1; }
+
+    uint32_t count    = rd16(&tail[eocd + 10]);
+    uint32_t cdSize   = rd32(&tail[eocd + 12]);
+    uint32_t cdOffset = rd32(&tail[eocd + 16]);
+    if(count == 0xffff || cdSize == 0xffffffff || cdOffset == 0xffffffff) { fclose(f); return -1; }    // zip64
+    if((long) cdOffset + (long) cdSize > fileSize || cdSize > 16 * 1024 * 1024) { fclose(f); return -1; }
+
+    std::vector<unsigned char> cd(cdSize + 1);
+    if(fseek(f, cdOffset, SEEK_SET) != 0 || (cdSize > 0 && fread(&cd[0], 1, cdSize, f) != cdSize)) { fclose(f); return -1; }
+    fclose(f);
+
+    int64_t total = 0;
+    uint32_t pos = 0;
+    uint32_t n;
+    for(n = 0; n < count; n++) {
+        if(pos + 46 > cdSize || rd32(&cd[pos]) != 0x02014b50) return -1;
+        uint32_t usize = rd32(&cd[pos + 24]);
+        uint32_t csize = rd32(&cd[pos + 20]);
+        if(usize == 0xffffffff || csize == 0xffffffff) return -1;              // zip64 entry
+        total += usize;
+        pos += 46 + rd16(&cd[pos + 28]) + rd16(&cd[pos + 30]) + rd16(&cd[pos + 32]);
+    }
+
+    if(entries) *entries = (int) count;
+    return total;
+}
+
+static bool olderFirst(const UnpackCacheEntry &a, const UnpackCacheEntry &b)
+{
+    if(a.lastUsed != b.lastUsed) return a.lastUsed < b.lastUsed;
+    return a.name < b.name;
+}
+
+bool UnpackCachePolicy::pickEvictions(const std::vector<UnpackCacheEntry> &entries, int64_t freeBytes, int64_t need, std::vector<std::string> &evict)
+{
+    evict.clear();
+    if(need <= freeBytes) return true;
+
+    std::vector<UnpackCacheEntry> candidates;
+    for(size_t i = 0; i < entries.size(); i++) {
+        if(!entries[i].inSlot) candidates.push_back(entries[i]);
+    }
+    std::sort(candidates.begin(), candidates.end(), olderFirst);
+
+    int64_t avail = freeBytes;
+    for(size_t i = 0; i < candidates.size() && avail < need; i++) {
+        evict.push_back(candidates[i].name);
+        avail += candidates[i].size;
+    }
+
+    if(avail < need) {
+        evict.clear();
+        return false;
+    }
+    return true;
+}
