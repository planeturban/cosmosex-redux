+#ifndef SETTINGSRESOURCE_H
+#define	SETTINGSRESOURCE_H
+
+#include <string>
+
+#include "../../CivetServer.h"
+
+#include "iapiresource.h"
+
+struct cJSON;
+
+// Settings as JSON, for the web UI's Config page (the same settings as the
+// Atari config screens, with the same checks and the same reloads):
+//   GET /api/v1/settings              all sections
+//   GET /api/v1/settings/<section>    one section
+//   PUT /api/v1/settings/<section>    save one section (application/json only)
+// Sections: acsi, translated, shared, floppy, network, ikbd, other, hddimage.
+// Secrets are never returned: the shared drive password and the Wi-Fi key
+// are reported as "passwordSet" / "pskSet"; leave them out of a PUT (or
+// null) to keep them, send "" to clear.
+class SettingsResource : public IApiResource {
+public:
+    SettingsResource();
+    virtual ~SettingsResource();
+    bool dispatch(mg_connection *conn, mg_request_info *req_info, std::string sResourceInfo="" );
+
+private:
+    bool buildSection(const std::string &name, cJSON *out);
+    // false + message: invalid input, nothing saved
+    bool saveSection(const std::string &name, cJSON *in, std::string &message, std::string &warning);
+
+    void sendJson(mg_connection *conn, cJSON *root, int code = 200);
+    void sendError(mg_connection *conn, int code, const char *message);
+};
+
+#endif
