+#ifndef STORAGESHARE_H
+#define STORAGESHARE_H
+
+// storage sharing (NFS and SMB) for GET/PUT /api/v1/settings/storageshare: the settings
+// file STORAGESHARE_CONF, applied by the image's STORAGESHARE_TOOL (Buildroot image:
+// /usr/sbin/ce-storageshare). Without the tool the section reports "available":
+// false and refuses changes.
+
+#include <string>
+
+struct cJSON;
+
+#define STORAGESHARE_CONF    "/etc/ce-storageshare.conf"
+#define STORAGESHARE_TOOL    "/usr/sbin/ce-storageshare"
+
+bool storageshareBuild(cJSON *out);
+bool storageshareSave(cJSON *in, std::string &msg);
+
+#endif
