+#ifndef FILESRESOURCE_H
+#define FILESRESOURCE_H
+
+#include <string>
+#include <vector>
+
+#include "../../CivetServer.h"
+
+#include "iapiresource.h"
+
+// The web interface's Files page (two panes, as Midnight Commander): the
+// file work is done by the image's FILES_TOOL (Buildroot image:
+// /usr/sbin/ce-files), run without a shell for each request; a place is
+// "storage", "tr:<X>", "usb:<name>", "shared" or "img:<part>:<image>" (see
+// the tool).
+//
+//   GET  /api/v1/files/places                     {places: [{id, label, kind, freeKB, totalKB, writable}],
+//                                                  images: [{path, name, size}]}
+//   GET  /api/v1/files/list?place=&dir=           {dir, writable, names83, freeKB, totalKB,
+//                                                  entries: [{type, size, mtime, name}], more}
+//   GET  /api/v1/files/read?place=&file=          the file (a download)
+//   GET  /api/v1/files/zip?place=&dir=&name=...   those files and folders as one zip (name repeated)
+//   POST /api/v1/files/write?place=&dir=&name=[&overwrite=1]
+//                                                 the body (application/octet-stream, at most
+//                                                 FILES_PUT_MAX_MB) as a file: {name, size}
+//   POST /api/v1/files/mkdir   {place, dir, name}         {name}
+//   POST /api/v1/files/delete  {place, dir, names: []}    {deleted}
+//   POST /api/v1/files/rename  {place, dir, from, to}     {name}
+//
+// Errors: 400, 404, 409 (a name already there: {"error", "exists"}), 403
+// (read-only, or an image the ST has attached). The POSTs other than write
+// need Content-Type application/json (a page on another site can't send that
+// without asking first); write needs application/octet-stream.
+
+#define FILES_TOOL          "/usr/sbin/ce-files"
+#define FILES_PUT_MAX_MB    2048
+
+class FilesResource : public IApiResource {
+public:
+    FilesResource();
+    virtual ~FilesResource();
+    bool dispatch(mg_connection *conn, mg_request_info *req_info, std::string sResourceInfo="" );
+
+private:
+    void sendJson(mg_connection *conn, struct cJSON *root, int code = 200);
+    void sendError(mg_connection *conn, int code, const std::string &message);
+    void sendToolError(mg_connection *conn, int rc, const std::string &out);
+    void places(mg_connection *conn);
+    void list(mg_connection *conn, const char *qs);
+    void download(mg_connection *conn, const char *qs, bool zip);
+    void write(mg_connection *conn, const char *qs);
+    void change(mg_connection *conn, const std::string &what);
+};
+
+#endif
