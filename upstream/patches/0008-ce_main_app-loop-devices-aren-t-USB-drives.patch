From 3faecacfba4fbd8c6047f31e70b50756679a180e Mon Sep 17 00:00:00 2001
From: CosmosEx Buildroot <4372835+planeturban@users.noreply.github.com>
Date: Tue, 17 Nov 2026 21:33:46 +0100
Subject: [PATCH 8/8] ce_main_app: loop devices aren't USB drives

Every link in /dev/disk/by-uuid was taken for a USB drive. A loop device
with a file system on it (a disk image set up with losetup, a snap, a
RAM disk, device mapper) was cut at its first digit to "/dev/loop",
couldn't be mounted and showed up as a dead translated drive. loop*,
ram*, zram* and dm-* are skipped now (not in the PC build, which mounts
loop devices on purpose).
---
 ce_main_app/devfinder.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/ce_main_app/devfinder.cpp b/ce_main_app/devfinder.cpp
index ebb3200a..71f5fd6f 100644
--- a/ce_main_app/devfinder.cpp
+++ b/ce_main_app/devfinder.cpp
@@ -86,6 +86,12 @@ void DevFinder::lookForDevChanges(void)
                     cutBeforeFirstNumber(file);									// cut before the 1st number (e.g. sda1 -> sda)
 		}
 #else
+		// not USB drives: loop devices (e.g. a disk image set up with
+		// losetup), RAM disks, device mapper
+		if(file.compare(0, 4, "loop") == 0 || file.compare(0, 3, "ram") == 0 ||
+		   file.compare(0, 4, "zram") == 0 || file.compare(0, 3, "dm-") == 0) {
+			continue;
+		}
                 cutBeforeFirstNumber(file);									// cut before the 1st number (e.g. sda1 -> sda)
 #endif                
 		file = "/dev/" + file;										// create full path - /dev/sda
